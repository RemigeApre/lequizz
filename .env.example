PORT=3000
NODE_ENV=production
SESSION_SECRET=replace_with_a_long_random_string
SITE_PASSWORD=replace_with_a_shared_password
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=replace_with_output_of_npm_run_hash-password

# Optionnel : active le HTTPS (certificat auto-signe, voir DEPLOY.md).
# Laisser vide = le site tourne en HTTP simple.
TLS_CERT_PATH=
TLS_KEY_PATH=
# A mettre a true seulement quand TLS_CERT_PATH/TLS_KEY_PATH sont actifs.
FORCE_SECURE_COOKIE=false
