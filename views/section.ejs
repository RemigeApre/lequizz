<%- include('partials/head', { title: section.title + ' — ' + config.title }) %>
<main class="container wide">
  <%- include('partials/top-nav', { config: config }) %>
  <h1 class="section-title-h1"><%= section.title %></h1>
  <% if (section.intro) { %><p class="intro"><%= section.intro %></p><% } %>

  <%
    var LEVEL_COLORS = { jamais: "#7a7f87", a: "#6c8ebf", b: "#9b6cbf", c: "#4fa5a0", d: "#d9932f", e: "#c0455a" };

    // Le niveau (jamais/a..e) est un choix a part entiere, au meme titre que
    // la frequence : au rechargement, on rouvre sur le dernier niveau que la
    // personne a effectivement renseigne (le plus "avance", pas toujours
    // le premier), pour ne pas donner l'impression que la reponse a disparu.
    function pickDisplayLevel(levelsObj) {
      var chosen = config.levels[0].key;
      config.levels.forEach(function (lvl) {
        var v = levelsObj ? Number(levelsObj[lvl.key]) || 1 : 1;
        if (v > 1) chosen = lvl.key;
      });
      return chosen;
    }

    // Le niveau "jamais" a sa propre petite echelle (3 options), distincte
    // de l'echelle de frequence partagee par les autres niveaux.
    function scaleForLevel(levelKey) {
      var lvl = config.levels.find(function (l) { return l.key === levelKey; });
      return (lvl && lvl.scaleLabels) || config.scaleLabels;
    }

    // Reutilise le degrade de couleurs freq-val-1..5 existant : l'echelle a
    // 3 points de "jamais" pioche dedans a intervalles larges (1, 3, 5)
    // plutot que d'introduire un degrade parallele.
    function freqValClass(levelKey, value) {
      if (levelKey === "jamais") {
        return "freq-val-" + ([1, 3, 5][value - 1] || 1);
      }
      return "freq-val-" + value;
    }
  %>

  <form method="POST" action="/section/<%= idx %>" data-autosave-url="/section/<%= idx %>/autosave" style="--section-color: <%= section.color || '' %>;">
    <% if (section.type === "matrix") { %>
      <% var multiGroup = section.groups.length > 1; %>

      <%
        var existingMatrix = (existing && existing.matrix) || {};
      %>
      <% section.groups.forEach(function (group, gi) { %>
        <% var groupKey = section.key + ":" + group.id; %>
        <% var isDone = !!doneGroups[groupKey]; %>
        <details class="matrix-group<%= isDone ? ' done' : '' %>" <%= (!multiGroup || gi === 0) && !isDone ? "open" : "" %> data-group-id="<%= group.id %>">
          <summary>
            <span class="group-title-wrap">
              <span class="group-title-text"><%= group.title || "Toutes les pratiques" %></span>
              <span class="group-count-badge"><%= group.items.length %></span>
            </span>
            <button type="button" class="group-done-toggle<%= isDone ? ' active' : '' %>">
              <%- isDone ? "&#10003; Complet" : "Complet" %>
            </button>
            <input type="hidden" name="done_<%= group.id %>" class="group-done-hidden" value="<%= isDone ? 1 : 0 %>" />
          </summary>
          <div class="item-cards">
            <% group.items.forEach(function (item) { %>
              <% var itemKey = section.key + ":" + item.id; %>
              <% var favorited = !!bookmarks.favorite[itemKey]; %>
              <div class="item-card">
                <div class="item-header">
                  <div class="item-title-row">
                    <span class="item-name"><%= item.text %></span>
                    <div class="item-actions">
                      <%# Icone "?" reservee pour plus tard : n'apparaitra que si un lien wiki existe pour cette pratique. %>
                      <button type="button" class="item-fav-toggle<%= favorited ? ' active' : '' %>" title="Favori">
                        <%- favorited ? "&#9733;" : "&#9734;" %>
                      </button>
                    </div>
                    <input type="hidden" name="fav_<%= item.id %>" class="fav-hidden" value="<%= favorited ? 1 : 0 %>" />
                  </div>
                </div>

                <% if (item.variants) { %>
                  <div class="variant-pickers">
                    <% item.variants.forEach(function (variantLabel) { %>
                      <% var vKey = slugify(variantLabel); %>
                      <% var variantExisting = (existingMatrix[item.id] && existingMatrix[item.id][vKey]) || null; %>
                      <% var displayLevelKey = pickDisplayLevel(variantExisting); %>
                      <% var vDispVal = variantExisting ? Number(variantExisting[displayLevelKey]) || 1 : 1; %>
                      <div class="variant-block">
                        <span class="variant-label"><%= variantLabel %></span>
                        <div class="level-picker" data-item-id="<%= item.id %>" data-variant-key="<%= vKey %>">
                          <select class="level-select" style="border-left-color: <%= LEVEL_COLORS[displayLevelKey] %>">
                            <% config.levels.forEach(function (lvl) { %>
                              <option value="<%= lvl.key %>" <%= lvl.key === displayLevelKey ? "selected" : "" %> style="background-color: <%= LEVEL_COLORS[lvl.key] %>; color: #fff;"><%= lvl.label %></option>
                            <% }) %>
                          </select>
                          <select class="freq-select <%= freqValClass(displayLevelKey, vDispVal) %>">
                            <% scaleForLevel(displayLevelKey).forEach(function (label, li) { %>
                              <option value="<%= li + 1 %>" <%= vDispVal === (li + 1) ? "selected" : "" %>><%= label %></option>
                            <% }) %>
                          </select>
                        </div>
                        <% config.levels.forEach(function (lvl) { %>
                          <% var existingVal = variantExisting ? Number(variantExisting[lvl.key]) || 1 : 1; %>
                          <input type="hidden" name="m_<%= item.id %>_<%= vKey %>_<%= lvl.key %>" value="<%= existingVal %>" />
                        <% }) %>
                      </div>
                    <% }) %>
                  </div>
                <% } else { %>
                  <% var itemExisting = existingMatrix[item.id] || null; %>
                  <% var displayLevelKey = pickDisplayLevel(itemExisting); %>
                  <% var dispVal = itemExisting ? Number(itemExisting[displayLevelKey]) || 1 : 1; %>
                  <div class="level-picker" data-item-id="<%= item.id %>">
                    <select class="level-select" style="border-left-color: <%= LEVEL_COLORS[displayLevelKey] %>">
                      <% config.levels.forEach(function (lvl) { %>
                        <option value="<%= lvl.key %>" <%= lvl.key === displayLevelKey ? "selected" : "" %> style="background-color: <%= LEVEL_COLORS[lvl.key] %>; color: #fff;"><%= lvl.label %></option>
                      <% }) %>
                    </select>
                    <select class="freq-select <%= freqValClass(displayLevelKey, dispVal) %>">
                      <% scaleForLevel(displayLevelKey).forEach(function (label, li) { %>
                        <option value="<%= li + 1 %>" <%= dispVal === (li + 1) ? "selected" : "" %>><%= label %></option>
                      <% }) %>
                    </select>
                  </div>

                  <% config.levels.forEach(function (lvl) { %>
                    <% var existingVal = itemExisting ? Number(itemExisting[lvl.key]) || 1 : 1; %>
                    <input type="hidden" name="m_<%= item.id %>_<%= lvl.key %>" value="<%= existingVal %>" />
                  <% }) %>
                <% } %>
              </div>
            <% }) %>
          </div>

          <%
            var extrasHere = [];
            (section.rankings || []).forEach(function (r) { if (r.groupId === group.id) extrasHere.push({ type: "ranking", data: r }); });
            (section.spectrums || []).forEach(function (sp) { if (sp.groupId === group.id) extrasHere.push({ type: "spectrum", data: sp }); });
            (section.multiselects || []).forEach(function (ms) { if (ms.groupId === group.id) extrasHere.push({ type: "multiselect", data: ms }); });
          %>
          <% if (extrasHere.length) { %>
            <div class="extra-cards">
              <% extrasHere.forEach(function (ex) { %>
                <% if (ex.type === "ranking") { %>
                  <%- include('partials/extra-ranking', { r: ex.data }) %>
                <% } else if (ex.type === "spectrum") { %>
                  <%- include('partials/extra-spectrum', { sp: ex.data }) %>
                <% } else { %>
                  <%- include('partials/extra-multiselect', { ms: ex.data }) %>
                <% } %>
              <% }) %>
            </div>
          <% } %>
        </details>
      <% }) %>

      <%
        var groupIds = section.groups.map(function (g) { return g.id; });
        var leftoverRankings = (section.rankings || []).filter(function (r) { return groupIds.indexOf(r.groupId) === -1; });
        var leftoverSpectrums = (section.spectrums || []).filter(function (sp) { return groupIds.indexOf(sp.groupId) === -1; });
        var leftoverMultiselects = (section.multiselects || []).filter(function (ms) { return groupIds.indexOf(ms.groupId) === -1; });
      %>
      <% if (leftoverRankings.length || leftoverSpectrums.length || leftoverMultiselects.length) { %>
        <div class="extra-cards">
          <% leftoverRankings.forEach(function (r) { %>
            <%- include('partials/extra-ranking', { r: r }) %>
          <% }) %>
          <% leftoverSpectrums.forEach(function (sp) { %>
            <%- include('partials/extra-spectrum', { sp: sp }) %>
          <% }) %>
          <% leftoverMultiselects.forEach(function (ms) { %>
            <%- include('partials/extra-multiselect', { ms: ms }) %>
          <% }) %>
        </div>
      <% } %>
    <% } else if (section.type === "profile") { %>
      <% var existingFields = (existing && existing.fields) || {}; %>
      <% section.fields.forEach(function (f) { %>
        <div class="extra-card">
          <p class="extra-card-title"><%= f.label %></p>
          <div class="multiselect-options">
            <% f.options.forEach(function (opt, optIndex) { %>
              <label class="chip-option">
                <input type="radio" name="field_<%= f.id %>" value="<%= optIndex %>" <%= String(existingFields[f.id]) === String(optIndex) ? "checked" : "" %> />
                <span><%= opt %></span>
              </label>
            <% }) %>
          </div>
        </div>
      <% }) %>

      <% (section.rankings || []).forEach(function (r) { %>
        <%- include('partials/extra-ranking', { r: r }) %>
      <% }) %>
    <% } %>

    <div class="form-actions">
      <% if (idx > 0) { %><a href="/section/<%= idx - 1 %>" class="link-button">&larr; Section precedente</a><% } %>
      <button type="submit"><%= idx + 1 >= total ? "Voir mon resultat" : "Section suivante" %></button>
    </div>
  </form>
  <div id="autosave-status" class="autosave-status"></div>
</main>
<script>
  window.DEFAULT_SCALE = <%- JSON.stringify(config.scaleLabels) %>;
  window.JAMAIS_SCALE = <%- JSON.stringify(scaleForLevel("jamais")) %>;
</script>
<script src="/quiz.js?v=<%= assetVersion %>"></script>
<script src="/section.js?v=<%= assetVersion %>"></script>
<script src="/autosave.js?v=<%= assetVersion %>"></script>
<%- include('partials/foot') %>
