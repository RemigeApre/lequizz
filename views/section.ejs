<%- include('partials/head', { title: section.title + ' — ' + config.title }) %>
<main class="container wide">
  <%- include('partials/top-nav', { config: config }) %>
  <h1 class="section-title-h1"><%= section.title %></h1>
  <% if (section.intro) { %><p class="intro"><%= section.intro %></p><% } %>

  <%
    var LEVEL_COLORS = { a: "#6c8ebf", b: "#9b6cbf", c: "#4fa5a0", d: "#d9932f", e: "#c0455a" };
  %>

  <form method="POST" action="/section/<%= idx %>" style="--section-color: <%= section.color || '' %>;">
    <% if (section.type === "matrix") { %>
      <% var multiGroup = section.groups.length > 1; %>

      <%
        var globalIndex = 0;
        var existingMatrix = (existing && existing.matrix) || {};
        var rawItems = flattenItemsRaw(section);
      %>
      <% section.groups.forEach(function (group, gi) { %>
        <% var groupKey = section.key + ":" + gi; %>
        <% var isDone = !!doneGroups[groupKey]; %>
        <details class="matrix-group<%= isDone ? ' done' : '' %>" <%= (!multiGroup || gi === 0) && !isDone ? "open" : "" %> data-group-index="<%= gi %>">
          <summary>
            <span class="group-title-wrap">
              <span class="group-title-text"><%= group.title || "Toutes les pratiques" %></span>
              <span class="group-count-badge"><%= group.items.length %></span>
            </span>
            <button type="button" class="group-done-toggle<%= isDone ? ' active' : '' %>">
              <%- isDone ? "&#10003; Complet" : "Complet" %>
            </button>
            <input type="hidden" name="done_<%= gi %>" class="group-done-hidden" value="<%= isDone ? 1 : 0 %>" />
          </summary>
          <div class="item-cards">
            <% group.items.forEach(function () { %>
              <% var i = globalIndex; globalIndex += 1; %>
              <% var item = rawItems[i]; %>
              <% var itemKey = section.key + ":" + i; %>
              <% var toTest = !!bookmarks.toTest[itemKey]; %>
              <% var disliked = !!bookmarks.dislike[itemKey]; %>
              <% var favorited = !!bookmarks.favorite[itemKey]; %>
              <% var flagClass = toTest ? "flag-test" : (disliked ? "flag-dislike" : ""); %>
              <% var firstLevelKey = config.levels[0].key; %>
              <div class="item-card">
                <div class="item-header">
                  <div class="item-title-row">
                    <span class="item-name"><%= item.text %></span>
                    <div class="item-actions">
                      <%# Icone "?" reservee pour plus tard : n'apparaitra que si un lien wiki existe pour cette pratique. %>
                      <details class="item-flag">
                        <summary class="item-flag-summary <%= flagClass %>" title="Marquer">!</summary>
                        <div class="item-flag-menu">
                          <button type="button" class="item-flag-option" data-flag="test">A tester</button>
                          <button type="button" class="item-flag-option" data-flag="dislike">Aime pas</button>
                          <button type="button" class="item-flag-option" data-flag="none">Aucun</button>
                        </div>
                      </details>
                      <button type="button" class="item-fav-toggle<%= favorited ? ' active' : '' %>" title="Favori">
                        <%- favorited ? "&#9733;" : "&#9734;" %>
                      </button>
                    </div>
                    <input type="hidden" name="test_<%= i %>" class="test-hidden" value="<%= toTest ? 1 : 0 %>" />
                    <input type="hidden" name="dislike_<%= i %>" class="dislike-hidden" value="<%= disliked ? 1 : 0 %>" />
                    <input type="hidden" name="fav_<%= i %>" class="fav-hidden" value="<%= favorited ? 1 : 0 %>" />
                  </div>
                </div>

                <% if (item.variants) { %>
                  <div class="variant-pickers">
                    <% item.variants.forEach(function (variantLabel, vi) { %>
                      <% var variantExisting = (existingMatrix[i] && existingMatrix[i][vi]) || null; %>
                      <% var vFirstVal = variantExisting ? Number(variantExisting[firstLevelKey]) : 1; %>
                      <div class="variant-block">
                        <span class="variant-label"><%= variantLabel %></span>
                        <div class="level-picker" data-item-index="<%= i %>" data-variant-index="<%= vi %>">
                          <select class="level-select" style="border-left-color: <%= LEVEL_COLORS[firstLevelKey] %>">
                            <% config.levels.forEach(function (lvl) { %>
                              <% var v = variantExisting ? Number(variantExisting[lvl.key]) : 1; %>
                              <option value="<%= lvl.key %>" style="background-color: <%= LEVEL_COLORS[lvl.key] %>; color: #fff;"><%= lvl.label %> (<%= config.scaleLabels[v - 1] %>)</option>
                            <% }) %>
                          </select>
                          <select class="freq-select freq-val-<%= vFirstVal %>">
                            <% config.scaleLabels.forEach(function (label, li) { %>
                              <option value="<%= li + 1 %>" <%= vFirstVal === (li + 1) ? "selected" : "" %>><%= label %></option>
                            <% }) %>
                          </select>
                        </div>
                        <% config.levels.forEach(function (lvl) { %>
                          <% var existingVal = variantExisting ? Number(variantExisting[lvl.key]) : 1; %>
                          <input type="hidden" name="m_<%= i %>_<%= vi %>_<%= lvl.key %>" value="<%= existingVal %>" />
                        <% }) %>
                      </div>
                    <% }) %>
                  </div>
                <% } else { %>
                  <% var firstVal = existingMatrix[i] ? Number(existingMatrix[i][firstLevelKey]) : 1; %>
                  <div class="level-picker" data-item-index="<%= i %>">
                    <select class="level-select" style="border-left-color: <%= LEVEL_COLORS[firstLevelKey] %>">
                      <% config.levels.forEach(function (lvl) { %>
                        <% var v = existingMatrix[i] ? Number(existingMatrix[i][lvl.key]) : 1; %>
                        <option value="<%= lvl.key %>" style="background-color: <%= LEVEL_COLORS[lvl.key] %>; color: #fff;"><%= lvl.label %> (<%= config.scaleLabels[v - 1] %>)</option>
                      <% }) %>
                    </select>
                    <select class="freq-select freq-val-<%= firstVal %>">
                      <% config.scaleLabels.forEach(function (label, li) { %>
                        <option value="<%= li + 1 %>" <%= firstVal === (li + 1) ? "selected" : "" %>><%= label %></option>
                      <% }) %>
                    </select>
                  </div>

                  <% config.levels.forEach(function (lvl) { %>
                    <% var existingVal = existingMatrix[i] ? Number(existingMatrix[i][lvl.key]) : 1; %>
                    <input type="hidden" name="m_<%= i %>_<%= lvl.key %>" value="<%= existingVal %>" />
                  <% }) %>
                <% } %>
              </div>
            <% }) %>
          </div>

          <%
            var extrasHere = [];
            (section.rankings || []).forEach(function (r) { if (r.groupIndex === gi) extrasHere.push({ type: "ranking", data: r }); });
            (section.spectrums || []).forEach(function (sp) { if (sp.groupIndex === gi) extrasHere.push({ type: "spectrum", data: sp }); });
            (section.multiselects || []).forEach(function (ms) { if (ms.groupIndex === gi) extrasHere.push({ type: "multiselect", data: ms }); });
          %>
          <% if (extrasHere.length) { %>
            <div class="extra-cards">
              <% extrasHere.forEach(function (ex) { %>
                <% if (ex.type === "ranking") { %>
                  <%- include('partials/extra-ranking', { r: ex.data }) %>
                <% } else if (ex.type === "spectrum") { %>
                  <%- include('partials/extra-spectrum', { sp: ex.data }) %>
                <% } else { %>
                  <%- include('partials/extra-multiselect', { ms: ex.data }) %>
                <% } %>
              <% }) %>
            </div>
          <% } %>
        </details>
      <% }) %>

      <%
        var leftoverRankings = (section.rankings || []).filter(function (r) { return r.groupIndex === undefined || r.groupIndex === null; });
        var leftoverSpectrums = (section.spectrums || []).filter(function (sp) { return sp.groupIndex === undefined || sp.groupIndex === null; });
        var leftoverMultiselects = (section.multiselects || []).filter(function (ms) { return ms.groupIndex === undefined || ms.groupIndex === null; });
      %>
      <% if (leftoverRankings.length || leftoverSpectrums.length || leftoverMultiselects.length) { %>
        <div class="extra-cards">
          <% leftoverRankings.forEach(function (r) { %>
            <%- include('partials/extra-ranking', { r: r }) %>
          <% }) %>
          <% leftoverSpectrums.forEach(function (sp) { %>
            <%- include('partials/extra-spectrum', { sp: sp }) %>
          <% }) %>
          <% leftoverMultiselects.forEach(function (ms) { %>
            <%- include('partials/extra-multiselect', { ms: ms }) %>
          <% }) %>
        </div>
      <% } %>
    <% } else if (section.type === "profile") { %>
      <% var existingFields = (existing && existing.fields) || {}; %>
      <% section.fields.forEach(function (f) { %>
        <div class="extra-card">
          <p class="extra-card-title"><%= f.label %></p>
          <div class="multiselect-options">
            <% f.options.forEach(function (opt, optIndex) { %>
              <label class="chip-option">
                <input type="radio" name="field_<%= f.id %>" value="<%= optIndex %>" <%= String(existingFields[f.id]) === String(optIndex) ? "checked" : "" %> />
                <span><%= opt %></span>
              </label>
            <% }) %>
          </div>
        </div>
      <% }) %>

      <% (section.rankings || []).forEach(function (r) { %>
        <%- include('partials/extra-ranking', { r: r }) %>
      <% }) %>
    <% } %>

    <div class="form-actions">
      <% if (idx > 0) { %><a href="/section/<%= idx - 1 %>" class="link-button">&larr; Section precedente</a><% } %>
      <button type="submit"><%= idx + 1 >= total ? "Voir mon resultat" : "Section suivante" %></button>
    </div>
  </form>
</main>
<script src="/quiz.js"></script>
<script src="/section.js"></script>
<%- include('partials/foot') %>
