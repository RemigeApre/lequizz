<%- include('partials/head', { title: 'Mes favoris — ' + config.title }) %>
<main class="container wide">
  <%- include('partials/top-nav', { config: config }) %>

  <div class="admin-header">
    <h1 class="section-title-h1">Mon profil</h1>
    <form method="POST" action="/admin/logout">
      <button type="submit" class="link-button">Se d&eacute;connecter</button>
    </form>
  </div>

  <details class="user-settings-panel" id="user-settings-panel">
    <summary class="user-settings-summary">Options</summary>
    <div class="user-settings-body">
      <div class="user-setting-group">
        <span class="user-setting-label">Ouverture des tags</span>
        <div class="user-setting-options" id="tag-nav-pref-options">
          <label class="user-setting-radio" data-val="ask">
            <input type="radio" name="tag-nav-pref" value="ask" />
            Demander
          </label>
          <label class="user-setting-radio" data-val="wiki">
            <input type="radio" name="tag-nav-pref" value="wiki" />
            Wiki
          </label>
          <label class="user-setting-radio" data-val="gallery">
            <input type="radio" name="tag-nav-pref" value="gallery" />
            Galerie
          </label>
        </div>
      </div>
    </div>
  </details>

  <h2>Mes favoris</h2>

  <% if (!wikiPages.length && !galleryImages.length && !bdBooks.length) { %>
    <p class="intro">Aucun favori pour l&apos;instant. Utilise le bouton favori sur une page wiki, une image de la galerie ou une BD pour l&apos;ajouter ici.</p>
  <% } %>

  <% if (wikiPages.length) { %>
    <h2>Pages wiki (<%= wikiPages.length %>)</h2>
    <div class="wiki-grid">
      <% wikiPages.forEach(function (page) { %>
        <%- include('partials/wiki-card', { page: page, categories: categories, showCategoryBadge: true }) %>
      <% }) %>
    </div>
  <% } %>

  <% if (galleryImages.length) { %>
    <h2>Galerie (<%= galleryImages.length %>)</h2>
    <div class="favoris-chip-list">
      <% galleryImages.forEach(function (img) { %>
        <span class="wiki-pl-card" data-fav-item data-item-type="gallery" data-item-id="<%= img.id %>">
          <a href="/galerie/<%= img.id %>/edit" class="wiki-pl-title"><%= img.title || "Sans titre" %></a>
          <button type="button" class="wiki-pl-remove" title="Retirer des favoris">&#215;</button>
        </span>
      <% }) %>
    </div>
  <% } %>

  <% if (bdBooks.length) { %>
    <h2>BD (<%= bdBooks.length %>)</h2>
    <div class="favoris-chip-list">
      <% bdBooks.forEach(function (book) { %>
        <span class="wiki-pl-card" data-fav-item data-item-type="bd" data-item-id="<%= book.id %>">
          <a href="/bd/<%= book.id %>" class="wiki-pl-title"><%= book.title %></a>
          <button type="button" class="wiki-pl-remove" title="Retirer des favoris">&#215;</button>
        </span>
      <% }) %>
    </div>
  <% } %>
</main>
<script>
// ── Paramètre ouverture des tags ──────────────────────────────────────────
(function() {
  var pref = localStorage.getItem("tag-nav-pref") || "ask";
  var labels = document.querySelectorAll(".user-setting-radio");
  function syncLabels() {
    labels.forEach(function(lbl) { lbl.classList.toggle("active", lbl.dataset.val === pref); });
  }
  syncLabels();
  labels.forEach(function(lbl) {
    var radio = lbl.querySelector("input");
    if (radio.value === pref) radio.checked = true;
    radio.addEventListener("change", function() {
      if (radio.checked) {
        pref = radio.value;
        localStorage.setItem("tag-nav-pref", pref);
        syncLabels();
      }
    });
  });
})();

// ── Favoris ───────────────────────────────────────────────────────────────
document.querySelectorAll("[data-fav-item] .wiki-pl-remove").forEach(function (btn) {
  btn.addEventListener("click", function () {
    var card = btn.closest("[data-fav-item]");
    fetch("/favoris/toggle", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ itemType: card.dataset.itemType, itemId: Number(card.dataset.itemId) }),
    })
      .then(function (r) { return r.json(); })
      .then(function (d) {
        if (d.ok && !d.active) card.remove();
      });
  });
});
</script>
<%- include('partials/foot') %>
