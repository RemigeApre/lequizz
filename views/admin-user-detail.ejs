<%- include('partials/head', { title: detail.user.displayName + ' — Admin' }) %>

<div class="admin-topbar">
  <a href="/admin#tab-utilisateurs" class="admin-topbar-back">&#8592; Retour</a>
  <span class="admin-topbar-title"><%= detail.user.displayName %></span>
  <form method="POST" action="/admin/logout" style="margin:0">
    <button type="submit" class="admin-topbar-logout">D&eacute;connexion</button>
  </form>
</div>

<main class="admin-main">

  <%# ── En-tête utilisateur ── %>
  <div class="aud-header">
    <div class="aud-identity">
      <span class="aud-name"><%= detail.user.displayName %></span>
      <span class="aud-username">@<%= detail.user.username %></span>
      <% if (detail.user.isAdmin) { %><span class="admin-badge-admin">Admin</span><% } %>
    </div>
    <div class="aud-meta">
      <span class="admin-muted">Compte cr&eacute;&eacute; le <%= new Date(detail.user.createdAt).toLocaleDateString('fr-FR') %></span>
      <% if (attempt) { %>
        <a href="/admin/live/<%= detail.user.id %>" class="admin-btn-link">D&eacute;tail complet du quizz &#8599;</a>
      <% } %>
    </div>
  </div>

  <%# ── Quizz ── %>
  <div class="aud-section">
    <h2 class="aud-section-title">R&eacute;ponses au quizz</h2>
    <% if (attempt && liveScores) { %>
      <div class="admin-progress-wrap">
        <% matrixSections.forEach(function(s) { %>
          <% var sc = liveScores.sections[s.key]; %>
          <% if (sc) { %>
          <div class="admin-progress-row">
            <span class="admin-progress-label"><%= s.title %></span>
            <div class="bar admin-bar"><div class="bar-fill" style="width:<%= sc.percentage %>%"></div></div>
            <span class="admin-progress-pct"><%= sc.percentage %>%</span>
          </div>
          <% } %>
        <% }) %>
      </div>
      <p class="admin-muted" style="margin-top:.5rem">
        Derni&egrave;re modification : <%= new Date(attempt.updatedAt).toLocaleString('fr-FR') %>
      </p>
    <% } else { %>
      <p class="admin-muted">Aucune r&eacute;ponse enregistr&eacute;e.</p>
    <% } %>
  </div>

  <%# ── Favoris ── %>
  <div class="aud-section">
    <h2 class="aud-section-title">Favoris (<%= detail.favorites.length %>)</h2>
    <% if (detail.favorites.length) { %>
      <% var favWiki    = detail.favorites.filter(function(f){ return f.itemType === 'wiki'; }); %>
      <% var favGallery = detail.favorites.filter(function(f){ return f.itemType === 'gallery'; }); %>
      <div class="aud-fav-cols">
        <% if (favWiki.length) { %>
        <div class="aud-fav-col">
          <span class="aud-fav-type-label">Wiki (<%= favWiki.length %>)</span>
          <ul class="aud-list">
            <% favWiki.forEach(function(f) { %>
            <li><a href="/wiki/<%= f.itemId %>"><%= f.title || '#' + f.itemId %></a></li>
            <% }) %>
          </ul>
        </div>
        <% } %>
        <% if (favGallery.length) { %>
        <div class="aud-fav-col">
          <span class="aud-fav-type-label">Galerie (<%= favGallery.length %>)</span>
          <ul class="aud-list">
            <% favGallery.forEach(function(f) { %>
            <li><a href="/galerie/<%= f.itemId %>/edit"><%= f.title || '#' + f.itemId %></a></li>
            <% }) %>
          </ul>
        </div>
        <% } %>
      </div>
    <% } else { %>
      <p class="admin-muted">Aucun favori.</p>
    <% } %>
  </div>

  <%# ── Notes sur les pages wiki ── %>
  <div class="aud-section">
    <h2 class="aud-section-title">Notes &amp; commentaires wiki (<%= detail.notes.length %>)</h2>
    <% if (detail.notes.length) { %>
      <div class="aud-notes-list">
        <% detail.notes.forEach(function(n) { %>
        <div class="aud-note-card">
          <div class="aud-note-header">
            <a href="/wiki/<%= n.pageId %>" class="aud-note-page"><%= n.title %></a>
            <span class="admin-muted" style="font-size:.75rem"><%= new Date(n.updatedAt).toLocaleDateString('fr-FR') %></span>
          </div>
          <p class="aud-note-content"><%= n.content %></p>
        </div>
        <% }) %>
      </div>
    <% } else { %>
      <p class="admin-muted">Aucune note.</p>
    <% } %>
  </div>

  <%# ── Pages Wiki les plus vues ── %>
  <div class="aud-section">
    <h2 class="aud-section-title">Pages wiki les plus visit&eacute;es</h2>
    <% if (detail.wikiViewCounts && detail.wikiViewCounts.length) { %>
      <table class="admin-table">
        <thead><tr><th>Page</th><th style="text-align:right">Visites</th></tr></thead>
        <tbody>
          <% detail.wikiViewCounts.forEach(function(v) { %>
          <tr>
            <td><a href="/wiki/<%= v.pageId %>"><%= v.title %></a></td>
            <td style="text-align:right;font-weight:600;color:var(--accent)"><%= v.viewCount %></td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    <% } else { %>
      <p class="admin-muted">Aucune visite wiki enregistr&eacute;e.</p>
    <% } %>
  </div>

  <%# ── Galerie les plus vues ── %>
  <div class="aud-section">
    <h2 class="aud-section-title">Images galerie les plus visit&eacute;es</h2>
    <% if (detail.galViewCounts && detail.galViewCounts.length) { %>
      <table class="admin-table">
        <thead><tr><th>Contenu</th><th>Type</th><th style="text-align:right">Visites</th></tr></thead>
        <tbody>
          <% detail.galViewCounts.forEach(function(v) { %>
          <tr>
            <td><a href="/galerie/<%= v.galleryId %>/edit"><%= v.title || '#' + v.galleryId %></a></td>
            <td class="admin-muted" style="font-size:.78rem"><%= v.contentType === 'bd' ? 'BD' : 'Image' %></td>
            <td style="text-align:right;font-weight:600;color:var(--accent)"><%= v.viewCount %></td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    <% } else { %>
      <p class="admin-muted">Aucune visite galerie enregistr&eacute;e.</p>
    <% } %>
  </div>

  <%# ── Activité wiki récente ── %>
  <div class="aud-section">
    <h2 class="aud-section-title">Activit&eacute; wiki r&eacute;cente (30 derni&egrave;res)</h2>
    <% if (detail.recentWikiViews.length) { %>
      <table class="admin-table">
        <thead><tr><th>Page</th><th style="text-align:right;white-space:nowrap">Date</th></tr></thead>
        <tbody>
          <% detail.recentWikiViews.forEach(function(v) { %>
          <tr>
            <td><a href="/wiki/<%= v.pageId %>"><%= v.title %></a></td>
            <td style="text-align:right;font-size:.78rem;color:var(--muted);white-space:nowrap"><%= new Date(v.createdAt).toLocaleString('fr-FR') %></td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    <% } else { %>
      <p class="admin-muted">Aucune activit&eacute; wiki enregistr&eacute;e.</p>
    <% } %>
  </div>

  <%# ── Activité galerie récente ── %>
  <div class="aud-section">
    <h2 class="aud-section-title">Activit&eacute; galerie r&eacute;cente (30 derni&egrave;res)</h2>
    <% if (detail.recentGalViews.length) { %>
      <table class="admin-table">
        <thead><tr><th>Contenu</th><th>Type</th><th style="text-align:right;white-space:nowrap">Date</th></tr></thead>
        <tbody>
          <% detail.recentGalViews.forEach(function(v) { %>
          <tr>
            <td><a href="/galerie/<%= v.galleryId %>/edit"><%= v.title || '#' + v.galleryId %></a></td>
            <td class="admin-muted" style="font-size:.78rem"><%= v.contentType === 'bd' ? 'BD' : 'Image' %></td>
            <td style="text-align:right;font-size:.78rem;color:var(--muted);white-space:nowrap"><%= new Date(v.createdAt).toLocaleString('fr-FR') %></td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    <% } else { %>
      <p class="admin-muted">Aucune activit&eacute; galerie enregistr&eacute;e.</p>
    <% } %>
  </div>

</main>
<%- include('partials/foot') %>
