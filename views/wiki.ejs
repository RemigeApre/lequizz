<%- include('partials/head', { title: lockedCategory ? lockedCategory.label : 'Toutes les pages' }) %>
<main class="container wide<%= lockedCategory ? ' wiki-locked' : '' %>"<% if (lockedCategory) { %> style="--ch-hue: <%= lockedCategory.hue %>"<% } %>>
  <%- include('partials/top-nav', { config: config }) %>

  <% if (lockedCategory) { %>

    <%# ─── SIDEBAR CATÉGORIE ────────────────────────────────────────────── %>
    <%# Sur desktop : panneau fixe à gauche, pleine hauteur, sans pousser  %>
    <%# la grille centrale. Sur mobile : bloc inline au-dessus de la grille.%>
    <aside class="wiki-cat-sidebar">

      <%# ─ En-tête : flèche retour + nom + nombre ─ %>
      <div class="wiki-chapter-hero">
        <div class="wiki-chapter-hero-top">
          <a href="/wiki" class="wiki-chapter-hero-back" title="Retour au sommaire" aria-label="Retour au sommaire">&larr;</a>
          <h1 class="wiki-chapter-hero-title"><%= lockedCategory.label %></h1>
          <span class="wiki-chapter-hero-count"><%= pages.length %></span>
        </div>
        <% if (lockedCategory.desc) { %><p class="wiki-chapter-hero-desc"><%= lockedCategory.desc %></p><% } %>
      </div>

      <%# ─ Corps scrollable : recherche + filtres ─ %>
      <div class="wiki-sidebar-body">

        <div class="wiki-search-wrap">
          <div class="wiki-search-bar">
            <span class="wiki-search-icon">&#128269;</span>
            <input type="search" id="wiki-search-input" class="wiki-search-input"
                   placeholder="Rechercher dans <%= lockedCategory.label %>&hellip;"
                   autocomplete="off" />
            <button type="button" id="wiki-search-clear" class="wiki-search-clear" hidden>&#215;</button>
          </div>
          <span id="wiki-result-count" class="wiki-result-count" hidden></span>
        </div>

        <div class="wiki-sidebar-filters">

          <div class="wiki-filter-section">
            <span class="wiki-filter-label">Trier</span>
            <select id="wiki-sort-select" class="wiki-sort-select">
              <option value="alpha-asc">A &rarr; Z</option>
              <option value="alpha-desc">Z &rarr; A</option>
              <option value="date-desc">Plus r&eacute;cent</option>
              <option value="date-asc">Plus ancien</option>
              <option value="rating-desc">Mieux not&eacute;</option>
            </select>
          </div>

          <div class="wiki-filter-section wiki-filter-toggles">
            <button type="button" id="wiki-ultra-toggle" class="wiki-ultra-btn">&#128274; Masquer Ultra</button>
            <button type="button" id="wiki-fantaisie-toggle" class="wiki-ultra-btn">&#10024; Masquer Fantaisie</button>
          </div>

          <div class="wiki-filter-section">
            <span class="wiki-filter-label">Note min.</span>
            <div class="wiki-adv-stars" id="wiki-adv-stars">
              <% for (var si = 1; si <= 5; si++) { %>
                <button type="button" class="wiki-adv-star" data-value="<%= si %>">&#9734;</button>
              <% } %>
              <button type="button" class="wiki-adv-star-reset" id="wiki-adv-star-reset">&#10006;</button>
            </div>
            <label class="chip-option wiki-notrated-opt"><input type="checkbox" id="adv-not-rated" /><span>Pas encore not&eacute;</span></label>
          </div>

          <div class="wiki-filter-section wiki-adv-checks">
            <label class="chip-option"><input type="checkbox" id="adv-owned" /><span>&#9733; Poss&eacute;d&eacute;</span></label>
            <label class="chip-option"><input type="checkbox" id="adv-flame" /><span>&#128293; J&apos;adore</span></label>
            <label class="chip-option"><input type="checkbox" id="adv-interested" /><span>&#10024; Int&eacute;ress&eacute;e</span></label>
          </div>

          <% if (allTags.length) { %>
            <div class="wiki-filter-section">
              <span class="wiki-filter-label">Tags</span>
              <input type="search" id="wiki-tag-search" class="wiki-tag-search-input" placeholder="Chercher un tag&hellip;" autocomplete="off" />
              <div class="links-filter wiki-tag-cloud" id="wiki-tag-filter">
                <button type="button" class="tag-chip active" data-tag="">Tous</button>
                <% allTags.forEach(function (tag) { %>
                  <button type="button" class="tag-chip" data-tag="<%= tag %>"><%= tag %></button>
                <% }) %>
              </div>
            </div>
          <% } %>

        </div><%# /wiki-sidebar-filters %>

      </div><%# /wiki-sidebar-body %>
    </aside>

  <% } else { %>

    <%# ─── EN-TÊTE "TOUTES LES PAGES" ───────────────────────────────────── %>
    <div class="wiki-page-header">
      <a href="/wiki" class="link-button">&larr; Sommaire</a>
      <h1 class="section-title-h1">Toutes les pages</h1>
    </div>

    <%# ─── RECHERCHE : toujours visible ──────────────────────────────────── %>
    <div class="wiki-search-wrap">
      <div class="wiki-search-bar">
        <span class="wiki-search-icon">&#128269;</span>
        <input type="search" id="wiki-search-input" class="wiki-search-input"
               placeholder="Rechercher une page&hellip;" autocomplete="off" />
        <button type="button" id="wiki-search-clear" class="wiki-search-clear" hidden>&#215;</button>
      </div>
      <span id="wiki-result-count" class="wiki-result-count" hidden></span>
    </div>

    <%# ─── FILTRES + TRI ─────────────────────────────────────────────────── %>
    <details class="wiki-filters-panel" id="wiki-filters-panel">
      <summary class="wiki-filters-summary">Filtres &amp; tri</summary>
      <div class="wiki-filters-body">
        <button type="button" id="wiki-adv-toggle" class="wiki-adv-toggle">Filtres avancés &#9662;</button>
        <div id="wiki-adv-panel" class="wiki-adv-panel" hidden>
          <div class="wiki-adv-row">
            <label class="wiki-adv-label">Note min.</label>
            <div class="wiki-adv-stars" id="wiki-adv-stars">
              <% for (var si = 1; si <= 5; si++) { %>
                <button type="button" class="wiki-adv-star" data-value="<%= si %>">&#9734;</button>
              <% } %>
              <button type="button" class="wiki-adv-star-reset" id="wiki-adv-star-reset">&#10006;</button>
            </div>
          </div>
          <label class="chip-option" style="margin-top:0.25rem"><input type="checkbox" id="adv-not-rated" /><span>Pas encore not&eacute;</span></label>
          <div class="wiki-adv-checks">
            <label class="chip-option"><input type="checkbox" id="adv-owned" /><span>&#9733; Poss&eacute;d&eacute;</span></label>
            <label class="chip-option"><input type="checkbox" id="adv-flame" /><span>&#128293; J&apos;adore</span></label>
            <label class="chip-option"><input type="checkbox" id="adv-interested" /><span>&#10024; Int&eacute;ress&eacute;e</span></label>
          </div>
        </div>

        <div class="wiki-controls">
          <div class="links-filter" id="wiki-category-filter">
            <button type="button" class="tag-chip active" data-category="">Tous</button>
            <% categories.forEach(function (c) { %>
              <button type="button" class="tag-chip" data-category="<%= c.key %>"><%= c.label %></button>
            <% }) %>
            <button type="button" class="tag-chip tag-chip-owned" data-category="__owned__">&#9733; Nos objets</button>
          </div>

          <% if (allTags.length) { %>
            <div class="links-filter" id="wiki-tag-filter">
              <button type="button" class="tag-chip active" data-tag="">Tous les tags</button>
              <% allTags.forEach(function (tag) { %>
                <button type="button" class="tag-chip" data-tag="<%= tag %>"><%= tag %></button>
              <% }) %>
            </div>
          <% } %>

          <div class="wiki-sort-row">
            <button type="button" id="wiki-ultra-toggle" class="wiki-ultra-btn">&#128274; Masquer Ultra</button>
            <button type="button" id="wiki-fantaisie-toggle" class="wiki-ultra-btn">&#10024; Masquer Fantaisie</button>
            <label class="wiki-sort-label" for="wiki-sort-select">Trier&nbsp;:</label>
            <select id="wiki-sort-select" class="wiki-sort-select">
              <option value="alpha-asc" selected>A &rarr; Z</option>
              <option value="alpha-desc">Z &rarr; A</option>
              <option value="date-desc">Plus r&eacute;cent</option>
              <option value="date-asc">Plus ancien</option>
              <option value="rating-desc">Mieux not&eacute;</option>
              <option value="category">Cat&eacute;gorie</option>
            </select>
          </div>
        </div>

      </div>
    </details>

  <% } %>

  <%# ─── GRILLE ────────────────────────────────────────────────────────── %>
  <div class="wiki-grid" id="wiki-list">
    <% if (!pages.length) { %>
      <p class="intro">Aucune page pour l&apos;instant.</p>
    <% } %>
    <% pages.forEach(function (page) { %>
      <%- include('partials/wiki-card', { page: page, categories: categories, showCategoryBadge: !lockedCategory }) %>
    <% }) %>
  </div>
</main>
<script src="/wiki.js?v=<%= assetVersion %>"></script>
<%- include('partials/foot') %>
