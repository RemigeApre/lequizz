<div class="code-banner">
  <span>Code de reprise : <strong><%= code %></strong> — note-le pour continuer sur un autre appareil</span>
  <form method="GET" action="/" class="code-switch-form">
    <input type="text" name="code" placeholder="Code (autre appareil)" maxlength="6" />
    <button type="submit" class="link-button">Charger ce code</button>
  </form>
</div>
