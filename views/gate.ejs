<%- include('partials/head', { title: 'Acces' }) %>
<main class="container narrow gate-page">
  <h1>Acces prive</h1>
  <p class="intro">Ce site est reserve. Entre le mot de passe pour continuer.</p>

  <% if (error) { %>
    <p class="error"><%= error %></p>
  <% } %>

  <form method="POST" action="/gate">
    <label>
      Mot de passe
      <input type="password" name="password" required autofocus />
    </label>
    <button type="submit">Entrer</button>
  </form>
</main>
<%- include('partials/foot') %>
