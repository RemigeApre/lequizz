<%- include('partials/head', { title: 'Admin' }) %>
<main class="container wide">
  <div class="admin-header">
    <h1>Panneau admin</h1>
    <div style="display:flex; gap:.6rem; align-items:center">
      <a href="/admin/profils" class="link-button">G&eacute;rer les profils</a>
      <form method="POST" action="/admin/logout">
        <button type="submit" class="link-button">Se deconnecter</button>
      </form>
    </div>
  </div>

  <% var matrixSections = config.sections.filter(function (s) { return s.type === "matrix"; }); %>

  <% userStates.forEach(function (state) { %>
  <div class="result-section">
    <div class="admin-header">
      <h2><%= state.user.displayName %></h2>
      <% if (state.attempt) { %><a href="/admin/live/<%= state.user.id %>" class="link-button">Voir le detail complet</a><% } %>
    </div>
    <% if (state.attempt) { %>
      <p class="intro">Derniere modification : <%= new Date(state.attempt.updatedAt).toLocaleString("fr-FR") %></p>

      <div class="result-row">
        <div class="result-label">
          <span>Progression globale</span>
          <span><%= state.livePercentage %>%</span>
        </div>
        <div class="bar"><div class="bar-fill" style="width: <%= state.livePercentage %>%"></div></div>
      </div>

      <% matrixSections.forEach(function (s) { %>
        <% var sc = state.liveScores.sections[s.key]; %>
        <div class="result-row">
          <div class="result-label">
            <span><%= s.title %></span>
            <span><%= sc.percentage %>%</span>
          </div>
          <div class="bar"><div class="bar-fill" style="width: <%= sc.percentage %>%"></div></div>
        </div>
      <% }) %>
    <% } else { %>
      <p class="intro">Aucune reponse enregistree pour l'instant.</p>
    <% } %>
  </div>
  <% }) %>

  <div class="admin-stats">
    <div class="admin-stat">
      <span class="admin-stat-value"><%= favoritesCount %></span>
      <span class="admin-stat-label">Favoris</span>
    </div>
    <div class="admin-stat">
      <span class="admin-stat-value"><%= linksCount %></span>
      <span class="admin-stat-label">Liens enregistres</span>
    </div>
    <div class="admin-stat">
      <span class="admin-stat-value"><%= wikiPages.length %></span>
      <span class="admin-stat-label">Pages wiki</span>
    </div>
  </div>

  <% if (wikiPages.length) { %>
  <div class="result-section">
    <h2>Pages wiki &mdash; vues</h2>
    <div class="table-scroll">
      <table class="admin-table">
        <thead>
          <tr><th>Page</th><th>Cat&eacute;gorie</th><th style="text-align:right">Vues</th></tr>
        </thead>
        <tbody>
          <% wikiPages.forEach(function (p) { %>
            <tr>
              <td><a href="/wiki/<%= p.id %>"><%= p.title %></a></td>
              <td><%= p.category %></td>
              <td style="text-align:right;font-variant-numeric:tabular-nums"><%= p.views %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
  <% } %>

  <% if (allWikiPagesSorted && allWikiPagesSorted.length) { %>
  <div class="result-section">
    <h2>Mise en avant &mdash; Accueil</h2>
    <p class="intro" style="margin-bottom:.75rem">Ces pages apparaissent comme &laquo;&nbsp;Ce qui pourrait t&apos;int&eacute;resser&nbsp;&raquo; sur la page d&apos;accueil.</p>
    <ul class="admin-featured-list">
      <% allWikiPagesSorted.forEach(function (p) { %>
        <li class="admin-featured-item" data-id="<%= p.id %>">
          <button type="button" class="admin-featured-toggle<%= p.featured ? ' active' : '' %>" title="<%= p.featured ? 'Retirer' : 'Mettre en avant' %>">
            <%= p.featured ? '&#9733;' : '&#9734;' %>
          </button>
          <a href="/wiki/<%= p.id %>" class="admin-featured-title"><%= p.title %></a>
          <span class="admin-featured-cat"><%= p.category %></span>
        </li>
      <% }) %>
    </ul>
  </div>
  <% } %>

  <h2>Historique des soumissions completes (<%= submissions.length %>)</h2>
  <div class="table-scroll">
    <table class="admin-table">
      <thead>
        <tr>
          <th>Profil</th>
          <th>Date</th>
          <% matrixSections.forEach(function (s) { %>
            <th><%= s.title %></th>
          <% }) %>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% submissions.forEach(function (sub) { %>
          <tr>
            <td><%= sub.userDisplayName || "—" %></td>
            <td><%= new Date(sub.createdAt).toLocaleString("fr-FR") %></td>
            <% matrixSections.forEach(function (s) { %>
              <td><%= sub.scores.sections[s.key] ? sub.scores.sections[s.key].percentage : "-" %>%</td>
            <% }) %>
            <td><a href="/admin/<%= sub.id %>">Detail</a></td>
          </tr>
        <% }) %>
        <% if (submissions.length === 0) { %>
          <tr><td colspan="<%= matrixSections.length + 3 %>">Aucune reponse pour le moment.</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
</main>
<script>
document.querySelectorAll(".admin-featured-toggle").forEach(function (btn) {
  btn.addEventListener("click", function () {
    var id = btn.closest("[data-id]").dataset.id;
    fetch("/admin/wiki-featured/" + id, { method: "POST" })
      .then(function (r) { return r.json(); })
      .then(function (d) {
        if (!d.ok) return;
        btn.classList.toggle("active", d.featured);
        btn.innerHTML = d.featured ? "&#9733;" : "&#9734;";
        btn.title = d.featured ? "Retirer" : "Mettre en avant";
      });
  });
});
</script>
<%- include('partials/foot') %>
