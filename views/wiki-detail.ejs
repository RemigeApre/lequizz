<%- include('partials/head', { title: page.title }) %>
<main class="container">
  <%- include('partials/top-nav', { config: config }) %>

  <% var cat = categories.find(function (c) { return c.key === page.category; }); %>
  <%
    var pm = page.meta || {};

    var FSUBS = { jeux_role: 'Jeux de rôle et comportement', hardcore: 'Hardcore', bdsm: 'BDSM', classique: 'Classique', fantaisie: 'Fantaisie' };
    var nbF = pm.nb_femmes, nbH = pm.nb_hommes;
    var hasPartMeta = page.category === 'partenaires' && (nbF || nbH);
    var LIEU = { prive: 'Privé', public: 'Public', cache: 'Caché' };
    var GODE = { animal: 'Animal', monstre: 'Monstre', fantaisiste: 'Fantaisiste', ethnique: 'Ethnique', autre: 'Autre' };
    var QUI  = { femme: 'Femme', homme: 'Homme', variable: 'Variable', aucun: 'Aucun / debout' };
    var CAN  = { vagin: 'Vagin', anus: 'Anus', bouche: 'Bouche', mains: 'Mains', autre: 'Autre' };
    var ORI  = { face_a_face: 'Face à face', face_contre_dos: 'Face contre dos', acrobatique: 'Acrobatique', autre: 'Autre' };
    var pmOri = Array.isArray(pm.orientation) ? pm.orientation : (pm.orientation ? [pm.orientation] : []);
    var hasPosMeta = page.category === 'position' && (pm.qui_dessus || (pm.canal && pm.canal.length) || pmOri.length);

    var hasMeta = (page.category === 'fantasmes' && pm.sous_cat && FSUBS[pm.sous_cat])
               || hasPartMeta
               || (page.category === 'lieux' && pm.type_lieu && LIEU[pm.type_lieu])
               || hasPosMeta
               || (page.category === 'objets' && pm.type_gode && GODE[pm.type_gode]);

    var hasImages = page.imagePaths && page.imagePaths.length;
    var hasAnyTags = page.tags.length || (pm.termes_derives && pm.termes_derives.length) || pm.anglais;
  %>

  <script id="wiki-existing-pages" type="application/json"><%- JSON.stringify(pages.map(function(p){ return { id: p.id, title: p.title }; })) %></script>

  <article class="wiki-detail" style="--ch-hue: <%= cat ? cat.hue : 220 %>">

    <%# ─ Bandeau : couleur du chapitre, retour à gauche, titre centré ─ %>
    <div class="wiki-detail-banner">
      <a href="<%= backHref %>" class="wiki-detail-banner-back" title="<%= backLabel %>" aria-label="<%= backLabel %>">&#8592;</a>
      <h1 class="wiki-detail-banner-title"><%= page.title %></h1>
      <% if ((page.extraCategories && page.extraCategories.length) || page.owned) { %>
        <div class="wiki-detail-banner-sub">
          <% if (page.owned) { %><span>&#9733; Poss&eacute;d&eacute;</span><% } %>
          <% (page.extraCategories || []).forEach(function (eck) { var ecat = categories.find(function (c) { return c.key === eck; }); %>
            <span><%= ecat ? ecat.label : eck %></span>
          <% }) %>
        </div>
      <% } %>
    </div>

    <%# ─ Navigation : sous le bandeau sur PC, discrète et flottante à
         mi-hauteur sur téléphone (voir CSS). Suit la position dans le
         contexte de navigation courant (recherche, chapitre…), avec
         repli sur l'ordre alphabétique global si aucun contexte. ─ %>
    <%# Toujours la même structure (a + arrow + label), même sans page
         précédente/suivante : le JS de contexte (recherche, chapitre…)
         doit pouvoir l'activer/la remplir sans reconstruire le DOM. ─ %>
    <nav class="wiki-page-nav" aria-label="Navigation entre pages">
      <a href="<%= prevPage ? '/wiki/' + prevPage.id : '#' %>" class="wiki-page-nav-btn wiki-page-nav-prev<%= prevPage ? '' : ' wiki-page-nav-disabled' %>" id="wiki-nav-prev" title="<%= prevPage ? prevPage.title : '' %>">
        <span class="wiki-page-nav-arrow">&#8592;</span>
        <span class="wiki-page-nav-label"><%= prevPage ? prevPage.title : '' %></span>
      </a>
      <a href="<%= nextPage ? '/wiki/' + nextPage.id : '#' %>" class="wiki-page-nav-btn wiki-page-nav-next<%= nextPage ? '' : ' wiki-page-nav-disabled' %>" id="wiki-nav-next" title="<%= nextPage ? nextPage.title : '' %>">
        <span class="wiki-page-nav-label"><%= nextPage ? nextPage.title : '' %></span>
        <span class="wiki-page-nav-arrow">&#8594;</span>
      </a>
    </nav>

    <%# ─ Note : grosse, centrée, fonctionnelle — c'est ici qu'on note ─ %>
    <div class="wiki-detail-rating" data-id="<%= page.id %>" data-rating="<%= page.rating %>">
      <% for (var i = 1; i <= 5; i++) { %>
        <button type="button" class="wiki-star wiki-star-lg" data-value="<%= i %>"><%- i <= page.rating ? '&#9733;' : '&#9734;' %></button>
      <% } %>
    </div>

    <%# ─ Image principale ─ %>
    <% if (hasImages) { %>
      <div class="wiki-infobox-images wiki-detail-main-images">
        <img src="<%= page.imagePaths[0] %>" alt="" class="wiki-infobox-img" />
      </div>
    <% } %>

    <%# ─ Vrai bandeau d'information façon Wikipedia : catégorie + reste ─ %>
    <div class="wiki-infotable">
      <div class="wiki-infotable-head" style="background: hsl(<%= cat ? cat.hue : 220 %>, 42%, 30%)"><%= cat ? cat.label : page.category %></div>
      <% if (hasMeta) { %>
        <dl class="wiki-infotable-body">

          <% if (page.category === 'fantasmes' && pm.sous_cat && FSUBS[pm.sous_cat]) { %>
            <div class="wiki-infobox-row">
              <dt>Cat&eacute;gorie</dt>
              <dd><%= FSUBS[pm.sous_cat] %></dd>
            </div>
          <% } %>

          <% if (hasPartMeta) { %>
            <% if (nbF) { %>
              <div class="wiki-infobox-row">
                <dt>Femmes</dt>
                <dd><%= nbF === 'nombreux' ? 'Nombreuses' : nbF %></dd>
              </div>
            <% } %>
            <% if (nbH) { %>
              <div class="wiki-infobox-row">
                <dt>Hommes</dt>
                <dd><%= nbH === 'nombreux' ? 'Nombreux' : nbH %></dd>
              </div>
            <% } %>
          <% } %>

          <% if (page.category === 'objets' && pm.type_gode && GODE[pm.type_gode]) { %>
            <div class="wiki-infobox-row">
              <dt>Type</dt>
              <dd><%= GODE[pm.type_gode] %></dd>
            </div>
          <% } %>

          <% if (page.category === 'lieux' && pm.type_lieu && LIEU[pm.type_lieu]) { %>
            <div class="wiki-infobox-row">
              <dt>Type</dt>
              <dd><%= LIEU[pm.type_lieu] %></dd>
            </div>
          <% } %>

          <% if (hasPosMeta) { %>
            <% if (pm.qui_dessus && QUI[pm.qui_dessus]) { %>
              <div class="wiki-infobox-row">
                <dt>Au-dessus</dt>
                <dd><%= QUI[pm.qui_dessus] %></dd>
              </div>
            <% } %>
            <% if (pm.canal && pm.canal.length) { %>
              <div class="wiki-infobox-row">
                <dt>Canal</dt>
                <dd><%= pm.canal.map(function(c){ return CAN[c] || c; }).join(' · ') %></dd>
              </div>
            <% } %>
            <% if (pmOri.length) { %>
              <div class="wiki-infobox-row">
                <dt>Orientation</dt>
                <dd><%= pmOri.map(function(o){ return ORI[o] || o; }).join(' · ') %></dd>
              </div>
            <% } %>
          <% } %>

        </dl>
      <% } %>
    </div>

    <%# ─ Réactions : flamme / intérêt (la note a rejoint le haut de page) ─ %>
    <div class="wiki-react wiki-detail-react"
      data-id="<%= page.id %>"
      data-flame="<%= page.flame ? '1' : '0' %>"
      data-interested="<%= page.interested ? '1' : '0' %>">
      <div class="wiki-react-toggles">
        <button type="button" class="wiki-react-btn wiki-react-flame<%= page.flame ? ' active' : '' %>" data-key="flame">
          <span class="wiki-react-icon">&#128293;</span><span class="wiki-react-label">J&apos;adore</span>
        </button>
        <button type="button" class="wiki-react-btn wiki-react-interest<%= page.interested ? ' active' : '' %>" data-key="interested">
          <span class="wiki-react-icon">&#10024;</span><span class="wiki-react-label">Int&eacute;ress&eacute;e</span>
        </button>
      </div>
    </div>

    <%# ─ Description : section principale + sections repliables ─ %>
    <% if (page.content) { %>
      <div class="wiki-md"><span class="wiki-md-raw" hidden><%= page.content %></span></div>
    <% } %>

    <%# ─ Images suivantes : carrousel, après la description ─ %>
    <% if (hasImages && page.imagePaths.length > 1) { %>
      <div class="wiki-infobox-images wiki-infobox-images-rest">
        <% page.imagePaths.slice(1).forEach(function (src) { %>
          <img src="<%= src %>" alt="" class="wiki-infobox-img" />
        <% }) %>
      </div>
    <% } %>

    <%# ─ Tag : tags + mots dérivés, dans un espace réduit et centré ─ %>
    <% if (hasAnyTags) { %>
      <div class="wiki-detail-tag-block">
        <p class="wiki-detail-tag-label">Tag</p>
        <div class="link-card-tags wiki-detail-tags">
          <% if (pm.anglais) { %><span class="wiki-anglais-badge">&#127468;&#127463; Anglais</span><% } %>
          <% page.tags.forEach(function (t) { %><span class="link-tag-pill"><%= t %></span><% }) %>
          <% if (pm.termes_derives && pm.termes_derives.length) { %>
            <span class="wiki-derived-sep">&mdash;</span>
            <% pm.termes_derives.forEach(function (t) { %><span class="wiki-derived-pill"><%= t %></span><% }) %>
          <% } %>
        </div>
      </div>
    <% } %>

    <%# ─ Suggestions ─ %>
    <% if (suggestions && suggestions.length) { %>
      <div class="wiki-suggestions">
        <h3 class="wiki-sugg-heading">Pages similaires</h3>
        <div class="wiki-sugg-row">
          <% suggestions.forEach(function (s) { %>
            <% var scat = categories.find(function (c) { return c.key === s.category; }); %>
            <a href="/wiki/<%= s.id %>" class="wiki-sugg-card">
              <% if (s.imagePaths && s.imagePaths.length) { %>
                <div class="wiki-sugg-img-wrap">
                  <img src="<%= s.imagePaths[0] %>" alt="" class="wiki-sugg-img" />
                </div>
              <% } %>
              <span class="wiki-sugg-badge" style="background: hsl(<%= scat ? scat.hue : 220 %>, 55%, 45%)"><%= scat ? scat.label : s.category %></span>
              <span class="wiki-sugg-title"><%= s.title %></span>
              <% if (s.rating) { %><span class="wiki-sugg-stars"><% for (var si2=1;si2<=s.rating;si2++){ %>&#9733;<% } %></span><% } %>
            </a>
          <% }) %>
        </div>
      </div>
    <% } %>

    <div class="wiki-detail-actions">
      <a href="/wiki/<%= page.id %>/edit" class="wiki-edit-icon-btn" title="Modifier" aria-label="Modifier">&#9998;</a>
    </div>

  </article>
</main>
<script src="/wiki.js?v=<%= assetVersion %>"></script>
<%- include('partials/foot') %>
