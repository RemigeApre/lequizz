<%- include('partials/head', { title: page.title + ' \u2014 Wiki \u2014 ' + config.title }) %>
<main class="container">
  <%- include('partials/top-nav', { config: config }) %>
  <a href="/wiki" class="link-button">&larr; Retour au wiki</a>

  <% var cat = categories.find(function (c) { return c.key === page.category; }); %>
  <%
    var pm = page.meta || {};

    var FSUBS = { jeux_role: 'Jeux de r\u00f4le et comportement', hardcore: 'Hardcore', bdsm: 'BDSM', classique: 'Classique', fantaisie: 'Fantaisie' };
    var nbF = pm.nb_femmes, nbH = pm.nb_hommes;
    var hasPartMeta = page.category === 'partenaires' && (nbF || nbH);
    var LIEU = { prive: 'Priv\u00e9', public: 'Public', cache: 'Cach\u00e9' };
    var GODE = { animal: 'Animal', monstre: 'Monstre', fantaisiste: 'Fantaisiste', ethnique: 'Ethnique', autre: 'Autre' };
    var QUI  = { femme: 'Femme', homme: 'Homme', variable: 'Variable', aucun: 'Aucun\u00a0/ debout' };
    var CAN  = { vagin: 'Vagin', anus: 'Anus', bouche: 'Bouche', mains: 'Mains', autre: 'Autre' };
    var ORI  = { face_a_face: 'Face \u00e0 face', face_contre_dos: 'Face contre dos', acrobatique: 'Acrobatique', autre: 'Autre' };
    var pmOri = Array.isArray(pm.orientation) ? pm.orientation : (pm.orientation ? [pm.orientation] : []);
    var hasPosMeta = page.category === 'position' && (pm.qui_dessus || (pm.canal && pm.canal.length) || pmOri.length);

    var hasMeta = (page.category === 'fantasmes' && pm.sous_cat && FSUBS[pm.sous_cat])
               || hasPartMeta
               || (page.category === 'lieux' && pm.type_lieu && LIEU[pm.type_lieu])
               || hasPosMeta
               || (page.category === 'objets' && pm.type_gode && GODE[pm.type_gode]);

    var hasImages = page.imagePaths && page.imagePaths.length;
    var hasInfobox = hasImages || hasMeta;
  %>

  <article class="wiki-detail">

    <div class="wiki-detail-header">
      <span class="wiki-category-badge" style="background: hsl(<%= cat ? cat.hue : 220 %>, 55%, 45%)"><%= cat ? cat.label : page.category %></span>
      <% if (page.extraCategories && page.extraCategories.length) { %>
        <% page.extraCategories.forEach(function(eck) { var ecat = categories.find(function(c){ return c.key === eck; }); %>
          <span class="wiki-category-badge wiki-category-badge-extra" style="background: hsl(<%= ecat ? ecat.hue : 220 %>, 55%, 45%)"><%= ecat ? ecat.label : eck %></span>
        <% }) %>
      <% } %>
      <% if (page.owned) { %><span class="wiki-owned-badge" title="Poss\u00e9d\u00e9">&#9733; Poss\u00e9d\u00e9</span><% } %>
    </div>

    <h1 class="wiki-detail-title"><%= page.title %></h1>

    <%
      var hasAnyTags = page.tags.length || (pm.termes_derives && pm.termes_derives.length) || pm.anglais;
    %>
    <% if (hasAnyTags) { %>
      <div class="link-card-tags wiki-detail-tags">
        <% if (pm.anglais) { %><span class="wiki-anglais-badge">&#127468;&#127463; Anglais</span><% } %>
        <% page.tags.forEach(function (t) { %><span class="link-tag-pill"><%= t %></span><% }) %>
        <% if (pm.termes_derives && pm.termes_derives.length) { %>
          <span class="wiki-derived-sep">&mdash;</span>
          <% pm.termes_derives.forEach(function (t) { %><span class="wiki-derived-pill"><%= t %></span><% }) %>
        <% } %>
      </div>
    <% } %>

    <%# ─ Corps : infobox flottante + texte ─ %>
    <div class="wiki-body">

      <% if (hasInfobox) { %>
        <aside class="wiki-infobox">

          <%# Première image %>
          <% if (hasImages) { %>
            <div class="wiki-infobox-images">
              <img src="<%= page.imagePaths[0] %>" alt="" class="wiki-infobox-img" />
            </div>
          <% } %>

          <%# Tags (dupliqués ici pour l'ordre mobile) %>
          <% if (hasAnyTags) { %>
            <div class="wiki-infobox-tags">
              <% if (pm.anglais) { %><span class="wiki-anglais-badge">&#127468;&#127463; Anglais</span><% } %>
              <% page.tags.forEach(function (t) { %><span class="link-tag-pill"><%= t %></span><% }) %>
              <% if (pm.termes_derives && pm.termes_derives.length) { %>
                <span class="wiki-derived-sep">&mdash;</span>
                <% pm.termes_derives.forEach(function (t) { %><span class="wiki-derived-pill"><%= t %></span><% }) %>
              <% } %>
            </div>
          <% } %>

          <%# Paramètres sous la première image %>
          <% if (hasMeta) { %>
            <dl class="wiki-infobox-params">

              <% if (page.category === 'fantasmes' && pm.sous_cat && FSUBS[pm.sous_cat]) { %>
                <div class="wiki-infobox-row">
                  <dt>Cat\u00e9gorie</dt>
                  <dd><%= FSUBS[pm.sous_cat] %></dd>
                </div>
              <% } %>

              <% if (hasPartMeta) { %>
                <% if (nbF) { %>
                  <div class="wiki-infobox-row">
                    <dt>Femmes</dt>
                    <dd><%= nbF === 'nombreux' ? 'Nombreuses' : nbF %></dd>
                  </div>
                <% } %>
                <% if (nbH) { %>
                  <div class="wiki-infobox-row">
                    <dt>Hommes</dt>
                    <dd><%= nbH === 'nombreux' ? 'Nombreux' : nbH %></dd>
                  </div>
                <% } %>
              <% } %>

              <% if (page.category === 'objets' && pm.type_gode && GODE[pm.type_gode]) { %>
                <div class="wiki-infobox-row">
                  <dt>Type</dt>
                  <dd><%= GODE[pm.type_gode] %></dd>
                </div>
              <% } %>

              <% if (page.category === 'lieux' && pm.type_lieu && LIEU[pm.type_lieu]) { %>
                <div class="wiki-infobox-row">
                  <dt>Type</dt>
                  <dd><%= LIEU[pm.type_lieu] %></dd>
                </div>
              <% } %>

              <% if (hasPosMeta) { %>
                <% if (pm.qui_dessus && QUI[pm.qui_dessus]) { %>
                  <div class="wiki-infobox-row">
                    <dt>Au-dessus</dt>
                    <dd><%= QUI[pm.qui_dessus] %></dd>
                  </div>
                <% } %>
                <% if (pm.canal && pm.canal.length) { %>
                  <div class="wiki-infobox-row">
                    <dt>Canal</dt>
                    <dd><%= pm.canal.map(function(c){ return CAN[c] || c; }).join('\u00a0\u00b7 ') %></dd>
                  </div>
                <% } %>
                <% if (pmOri.length) { %>
                  <div class="wiki-infobox-row">
                    <dt>Orientation</dt>
                    <dd><%= pmOri.map(function(o){ return ORI[o] || o; }).join('\u00a0\u00b7 ') %></dd>
                  </div>
                <% } %>
              <% } %>

            </dl>
          <% } %>

          <%# Réactions dans l'infobox %>
          <div class="wiki-react wiki-infobox-react"
            data-id="<%= page.id %>"
            data-rating="<%= page.rating %>"
            data-flame="<%= page.flame ? '1' : '0' %>"
            data-interested="<%= page.interested ? '1' : '0' %>">
            <div class="wiki-react-stars">
              <% for (var i = 1; i <= 5; i++) { %>
                <button type="button" class="wiki-star" data-value="<%= i %>"><%- i <= page.rating ? '&#9733;' : '&#9734;' %></button>
              <% } %>
            </div>
            <button type="button" class="wiki-react-btn wiki-react-flame<%= page.flame ? ' active' : '' %>" data-key="flame">
              <span class="wiki-react-icon">&#128293;</span><span class="wiki-react-label">J&apos;adore</span>
            </button>
            <button type="button" class="wiki-react-btn wiki-react-interest<%= page.interested ? ' active' : '' %>" data-key="interested">
              <span class="wiki-react-icon">&#10024;</span><span class="wiki-react-label">Int&eacute;ress&eacute;e</span>
            </button>
          </div>

          <%# Images suivantes après les caractéristiques %>
          <% if (hasImages && page.imagePaths.length > 1) { %>
            <div class="wiki-infobox-images wiki-infobox-images-rest">
              <% page.imagePaths.slice(1).forEach(function(src) { %>
                <img src="<%= src %>" alt="" class="wiki-infobox-img" />
              <% }) %>
            </div>
          <% } %>
        </aside>
      <% } %>

      <% if (page.content) { %>
        <div class="wiki-md"><span class="wiki-md-raw" hidden><%= page.content %></span></div>
      <% } %>

    </div>

    <%# ─ Suggestions ─ %>
    <% if (suggestions && suggestions.length) { %>
      <div class="wiki-suggestions">
        <h3 class="wiki-sugg-heading">Pages similaires</h3>
        <div class="wiki-sugg-row">
          <% suggestions.forEach(function (s) { %>
            <% var scat = categories.find(function (c) { return c.key === s.category; }); %>
            <a href="/wiki/<%= s.id %>" class="wiki-sugg-card">
              <% if (s.imagePaths && s.imagePaths.length) { %>
                <div class="wiki-sugg-img-wrap">
                  <img src="<%= s.imagePaths[0] %>" alt="" class="wiki-sugg-img" />
                </div>
              <% } %>
              <span class="wiki-sugg-badge" style="background: hsl(<%= scat ? scat.hue : 220 %>, 55%, 45%)"><%= scat ? scat.label : s.category %></span>
              <span class="wiki-sugg-title"><%= s.title %></span>
              <% if (s.rating) { %><span class="wiki-sugg-stars"><% for (var si2=1;si2<=s.rating;si2++){ %>&#9733;<% } %></span><% } %>
            </a>
          <% }) %>
        </div>
      </div>
    <% } %>

    <%# ─ Pages liées ─ %>
    <div class="wiki-page-links" data-page-id="<%= page.id %>">
      <h3 class="wiki-pl-heading">Pages li&eacute;es</h3>
      <div class="wiki-pl-body">
        <div class="wiki-pl-section">
          <div class="wiki-pl-cards" data-role="links"></div>
        </div>
        <div class="wiki-pl-section wiki-pl-backlinks-section" hidden>
          <p class="wiki-pl-back-label">R&eacute;f&eacute;renc&eacute;e par</p>
          <div class="wiki-pl-cards" data-role="backlinks"></div>
        </div>
      </div>
      <div class="wiki-pl-add">
        <input type="text" class="wiki-pl-search" placeholder="Lier une autre page&hellip;" autocomplete="off" />
        <ul class="wiki-pl-results"></ul>
      </div>
    </div>

    <%# ─ Questions liées au quizz ─ %>
    <div class="wiki-question-links" data-page-id="<%= page.id %>">
      <h3 class="wiki-ql-heading">Questions du quizz li&eacute;es</h3>
      <ul class="wiki-ql-list"></ul>
      <div class="wiki-ql-add">
        <input type="text" class="wiki-ql-search" placeholder="Associer une question&hellip;" autocomplete="off" />
        <ul class="wiki-ql-results"></ul>
      </div>
    </div>

    <div class="wiki-detail-actions">
      <a href="/wiki/<%= page.id %>/edit" class="link-button">Modifier</a>
      <form method="POST" action="/wiki/<%= page.id %>/delete" class="link-delete-form-inline">
        <button type="submit" class="link-delete-btn-text">Supprimer</button>
      </form>
    </div>

    <p class="wiki-detail-meta">Mis &agrave; jour le <%= new Date(page.updatedAt).toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' }) %></p>
  </article>
</main>
<script src="/wiki.js?v=<%= assetVersion %>"></script>
<%- include('partials/foot') %>
