<%- include('partials/head', { title: page.id ? 'Modifier \u2014 ' + page.title : 'Nouvelle page' }) %>
<main class="container">
  <%- include('partials/top-nav', { config: config }) %>

  <%# Bouton retour (fixe gauche) %>
  <a href="<%= returnTo || (page.id ? '/wiki/' + page.id : '/wiki') %>" class="wf-back-btn">&#8592; Retour</a>

  <%# Boutons Save + Cancel (fixe droite) %>
  <div class="wf-actions-right">
    <button type="submit" form="wiki-edit-form" class="wf-save-btn">Enregistrer</button>
    <a href="<%= returnTo || (page.id ? '/wiki/' + page.id : '/wiki') %>" class="wf-cancel-link">Annuler</a>
  </div>

  <%# Bouton suppression (fixe gauche, sous le retour) %>
  <% if (page.id) { %>
  <form method="POST" action="/wiki/<%= page.id %>/delete" class="wf-delete-form-fixed">
    <button type="submit" class="wf-delete-btn-fixed" title="Supprimer la page">&#128465;</button>
  </form>
  <% } %>

  <script id="wiki-existing-pages" type="application/json"><%- JSON.stringify(pages.map(function(p){ return { id: p.id, title: p.title }; })) %></script>

  <%
    var pm = page.meta || {};
    var SPECIAL_TAGS = ["ultra", "irréaliste"];
    var allTagsNormal = allTags.filter(function(t){ return SPECIAL_TAGS.indexOf(t) === -1; });
  %>

  <form method="POST" action="<%= page.id ? '/wiki/' + page.id : '/wiki/' %>" enctype="multipart/form-data" class="wiki-form" id="wiki-edit-form">
    <input type="hidden" name="_returnTo" value="<%= returnTo || '' %>" />

    <%# ── 1. Titre + Catégorie ── %>
    <div class="wf-title-row">
      <input type="text" name="title" class="wiki-title-input" required value="<%= page.title %>" placeholder="Titre&hellip;" />
      <select name="category" id="wiki-category-select" class="wiki-cat-inline-select">
        <% categories.forEach(function(c) { %>
          <option value="<%= c.key %>" data-hue="<%= c.hue %>" <%= c.key === page.category ? 'selected' : '' %>><%= c.label %></option>
        <% }) %>
      </select>
    </div>

    <%# On possède (objets / tenues) %>
    <label class="chip-option wiki-owned-chip" id="wiki-owned-field" <%= (page.category === 'objets' || page.category === 'tenues') ? '' : 'hidden' %>>
      <input type="checkbox" name="owned" <%= page.owned ? 'checked' : '' %> />
      <span>On poss&egrave;de</span>
    </label>

    <%# ── Synonymes (sans titre de section) ── %>
    <%
      var pmDerivedValue = (pm.termes_derives || []).map(function (t) {
        if (typeof t === 'string') return t;
        return t.term + (t.en ? '::en' : '');
      }).join(', ');
    %>
    <div class="wiki-derived-row">
      <div class="wiki-tags-widget wiki-derived-widget">
        <div class="wiki-tags-board">
          <input type="text" class="wiki-tags-typing" placeholder="Synonymes, termes d&eacute;riv&eacute;s&hellip;" autocomplete="off" />
        </div>
        <input type="hidden" name="meta_termes_derives" class="wiki-tags-hidden" value="<%= pmDerivedValue %>" />
      </div>
    </div>

    <%# ── Aussi dans (sans titre, directement sous les synonymes) ── %>
    <div class="wiki-extra-cats-field" id="wiki-edit-extra-cats">
      <div class="wiki-meta-options">
        <% categories.forEach(function(c) { %>
          <label class="chip-option wiki-extra-cat-option" data-cat="<%= c.key %>">
            <input type="checkbox" name="extra_categories" value="<%= c.key %>"
              <%= (page.extraCategories || []).indexOf(c.key) !== -1 ? 'checked' : '' %> />
            <span><%= c.label %></span>
          </label>
        <% }) %>
      </div>
    </div>

    <%# ── Description ── %>
    <div class="wf-section-title">Description</div>
    <div class="wiki-editor" data-rich>
      <div class="md-toolbar">
        <button type="button" class="md-btn" data-cmd="bold" title="Gras (Ctrl+B)"><strong>B</strong></button>
        <button type="button" class="md-btn md-btn-italic" data-cmd="italic" title="Italique (Ctrl+I)"><em>I</em></button>
        <span class="md-sep"></span>
        <button type="button" class="md-btn" data-cmd="h2">H2</button>
        <button type="button" class="md-btn" data-cmd="h3">H3</button>
        <span class="md-sep"></span>
        <button type="button" class="md-btn" data-cmd="list">&#8226;&nbsp;Liste</button>
        <button type="button" class="md-btn" data-cmd="hr">&mdash;</button>
        <span class="md-sep"></span>
        <span class="md-colors">
          <button type="button" class="md-color-btn" data-cmd="color" data-val="#e05c5c" style="background:#e05c5c" title="Rouge"></button>
          <button type="button" class="md-color-btn" data-cmd="color" data-val="#5cb8e0" style="background:#5cb8e0" title="Bleu"></button>
          <button type="button" class="md-color-btn" data-cmd="color" data-val="#6dd68a" style="background:#6dd68a" title="Vert"></button>
          <button type="button" class="md-color-btn" data-cmd="color" data-val="#e0b85c" style="background:#e0b85c" title="Or"></button>
          <button type="button" class="md-color-btn" data-cmd="color" data-val="#c45ce0" style="background:#c45ce0" title="Violet"></button>
          <button type="button" class="md-color-btn md-color-clear" data-cmd="color" data-val="" title="Effacer couleur">&#215;</button>
        </span>
        <span class="md-sep"></span>
        <button type="button" class="md-btn" data-cmd="wikilink" title="Lier une page wiki">&#9679;&nbsp;Wiki</button>
        <button type="button" class="md-btn" data-cmd="extlink" title="Lien externe">&#128279;</button>
      </div>
      <div class="wiki-richtext" contenteditable="true" spellcheck="true"></div>
      <input type="hidden" name="content" class="wiki-richtext-hidden" value="" />
    </div>

    <%# ── Scénario (partenaires seulement) ── %>
    <div id="wf-scenario-field" <%= page.category === 'partenaires' ? '' : 'hidden' %>>
      <div class="wf-section-title">Sc&eacute;nario</div>
      <div class="wiki-editor">
        <div class="md-toolbar">
          <button type="button" class="md-btn" data-md="bold"><strong>B</strong></button>
          <button type="button" class="md-btn md-btn-italic" data-md="italic"><em>I</em></button>
          <span class="md-sep"></span>
          <button type="button" class="md-btn" data-md="h2">H2</button>
          <button type="button" class="md-btn" data-md="h3">H3</button>
          <span class="md-sep"></span>
          <button type="button" class="md-btn" data-md="list">&#8226;&nbsp;Liste</button>
          <button type="button" class="md-btn" data-md="hr">&mdash;</button>
          <div class="md-toolbar-spacer"></div>
          <button type="button" class="md-btn md-preview-btn">Aper&ccedil;u</button>
        </div>
        <textarea name="meta_scenario" class="wiki-textarea wiki-pos-textarea" rows="6" placeholder="Une courte histoire, un contexte&hellip;"><%= pm.scenario || '' %></textarea>
        <div class="wiki-md-preview wiki-md" hidden></div>
      </div>
    </div>

    <%# ── Tags ── %>
    <div class="wf-section-title">Tags</div>
    <div class="wf-tags-unified">
      <%# Boutons ultra / irréaliste centrés %>
      <div class="wf-tags-special-row">
        <% SPECIAL_TAGS.forEach(function(t) { %>
          <button type="button" class="wiki-tag-suggest-chip wiki-tag-suggest-chip--special wf-tag-special" data-tag="<%= t %>"><%= t %></button>
        <% }) %>
      </div>
      <%# Widget principal : chips actifs + saisie + suggestions %>
      <div class="wiki-tags-widget">
        <div class="wiki-tags-board">
          <input type="text" class="wiki-tags-typing" placeholder="Ajouter un tag\u2026" autocomplete="off" />
        </div>
        <input type="hidden" name="tags" class="wiki-tags-hidden" value="<%= page.tags.join(', ') %>" />
        <% if (allTags.length) { %>
        <div class="wiki-tag-suggestions">
          <% allTags.forEach(function(t) { %>
            <button type="button" class="wiki-tag-suggest-chip" data-tag="<%= t %>"><%= t %></button>
          <% }) %>
        </div>
        <% } %>
      </div>
    </div>

    <%# ── Images ── %>
    <div class="wf-section-title">Images</div>
    <div class="wiki-image-field wf-image-field-centered">
      <% if (page.imagePaths && page.imagePaths.length) { %>
        <div class="wiki-images-existing">
          <% page.imagePaths.forEach(function(src, idx) { %>
            <div class="wiki-existing-img-wrap">
              <img src="<%= src %>" alt="" class="wiki-form-existing-image" />
              <label class="wiki-cover-radio-label" title="D&eacute;finir comme couverture">
                <input type="radio" name="cover_image" value="<%= src %>" class="wiki-cover-radio" <%= idx === 0 ? 'checked' : '' %> />
                <span class="wiki-cover-badge-icon">&#9733;</span>
              </label>
              <label class="wiki-img-remove-label">
                <input type="checkbox" name="remove_image" value="<%= src %>" />
                <span>&#215;</span>
              </label>
            </div>
          <% }) %>
        </div>
      <% } %>
      <label class="wf-add-images-btn">
        <span>+ Ajouter des images</span>
        <input type="file" name="images" accept="image/*" multiple class="wiki-image-input" />
      </label>
      <div class="wiki-new-previews"></div>
    </div>

    <%# ── Paramètres spécifiques à la catégorie ── %>

    <%# Fantasmes %>
    <div class="wiki-fantasmes-meta" <%= page.category === 'fantasmes' ? '' : 'hidden' %>>
      <div class="wf-section-title">Cat&eacute;gorie</div>
      <div class="wiki-meta-group">
        <div class="wiki-meta-options">
          <% fantasmesSubs.forEach(function(s) { %>
            <label class="chip-option"><input type="radio" name="meta_sous_cat" value="<%= s.key %>" <%= pm.sous_cat === s.key ? 'checked' : '' %>><span><%= s.label %></span></label>
          <% }) %>
        </div>
      </div>
    </div>

    <%# Partenaires %>
    <%
      var pmPartTypes = Array.isArray(pm.types) ? pm.types : [];
      function ckPart(v) { return pmPartTypes.indexOf(v) !== -1 ? 'checked' : ''; }
      function raPart(field, v) { return pm[field] === v ? 'checked' : ''; }
    %>
    <div class="wiki-partenaires-meta" <%= page.category === 'partenaires' ? '' : 'hidden' %>>
      <div class="wf-section-title">D&eacute;tails</div>
      <div class="wiki-meta-group">
        <p class="wiki-meta-label">Nombre total</p>
        <div class="wiki-meta-options">
          <% ['1','2','3','4','nombreux','variable'].forEach(function(v) { %>
            <label class="chip-option"><input type="radio" name="meta_nb_total" value="<%= v %>" <%= raPart('nb_total', v) %>><span><%= v === 'nombreux' ? 'Nombreux' : v === 'variable' ? 'Variable' : v %></span></label>
          <% }) %>
        </div>
      </div>
      <div class="wiki-meta-group">
        <p class="wiki-meta-label">F&eacute;minin</p>
        <div class="wiki-meta-options">
          <% ['0','1','2','3','4','nombreux','variable'].forEach(function(v) { %>
            <label class="chip-option"><input type="radio" name="meta_nb_feminin" value="<%= v %>" <%= raPart('nb_feminin', v) %>><span><%= v === 'nombreux' ? 'Nombreuses' : v === 'variable' ? 'Variable' : v %></span></label>
          <% }) %>
        </div>
      </div>
      <div class="wiki-meta-group">
        <p class="wiki-meta-label">Masculin</p>
        <div class="wiki-meta-options">
          <% ['0','1','2','3','4','nombreux','variable'].forEach(function(v) { %>
            <label class="chip-option"><input type="radio" name="meta_nb_masculin" value="<%= v %>" <%= raPart('nb_masculin', v) %>><span><%= v === 'nombreux' ? 'Nombreux' : v === 'variable' ? 'Variable' : v %></span></label>
          <% }) %>
        </div>
      </div>
      <div class="wiki-meta-group">
        <p class="wiki-meta-label">Type</p>
        <div class="wiki-meta-options">
          <label class="chip-option"><input type="checkbox" name="meta_types" value="nombre"    <%= ckPart('nombre') %>><span>Nombre</span></label>
          <label class="chip-option"><input type="checkbox" name="meta_types" value="fetichisme" <%= ckPart('fetichisme') %>><span>F&eacute;tichisme</span></label>
          <label class="chip-option"><input type="checkbox" name="meta_types" value="monstre"   <%= ckPart('monstre') %>><span>Monstre</span></label>
          <label class="chip-option"><input type="checkbox" name="meta_types" value="animaux"   <%= ckPart('animaux') %>><span>Animaux</span></label>
          <label class="chip-option"><input type="checkbox" name="meta_types" value="autre"     <%= ckPart('autre') %>><span>Autre</span></label>
        </div>
      </div>
    </div>

    <%# Objets %>
    <div class="wiki-objets-meta" <%= page.category === 'objets' ? '' : 'hidden' %>>
      <div class="wf-section-title">Type</div>
      <div class="wiki-meta-group">
        <div class="wiki-meta-options">
          <% [['animal','Animal'],['monstre','Monstre'],['fantaisiste','Fantaisiste'],['ethnique','Ethnique'],['autre','Autre']].forEach(function(o) { %>
            <label class="chip-option"><input type="radio" name="meta_type_gode" value="<%= o[0] %>" <%= pm.type_gode === o[0] ? 'checked' : '' %>><span><%= o[1] %></span></label>
          <% }) %>
        </div>
      </div>
    </div>

    <%# Lieux %>
    <div class="wiki-lieux-meta" <%= page.category === 'lieux' ? '' : 'hidden' %>>
      <div class="wf-section-title">Type de lieu</div>
      <div class="wiki-meta-group">
        <div class="wiki-meta-options">
          <label class="chip-option"><input type="radio" name="meta_type_lieu" value="prive"  <%= pm.type_lieu === 'prive'  ? 'checked' : '' %>><span>Priv&eacute;</span></label>
          <label class="chip-option"><input type="radio" name="meta_type_lieu" value="public" <%= pm.type_lieu === 'public' ? 'checked' : '' %>><span>Public</span></label>
          <label class="chip-option"><input type="radio" name="meta_type_lieu" value="cache"  <%= pm.type_lieu === 'cache'  ? 'checked' : '' %>><span>Cach&eacute;</span></label>
        </div>
      </div>
    </div>

    <%# Position %>
    <%
      var pmCanal = Array.isArray(pm.canal) ? pm.canal : (pm.canal ? [pm.canal] : []);
      var pmOri   = Array.isArray(pm.orientation) ? pm.orientation : (pm.orientation ? [pm.orientation] : []);
      var pmSup   = Array.isArray(pm.supports) ? pm.supports : (pm.supports ? [pm.supports] : []);
      function ck(arr, v) { return arr.indexOf(v) !== -1 ? 'checked' : ''; }
      function ra(val, v)  { return val === v ? 'checked' : ''; }
    %>
    <div class="wiki-position-meta" <%= page.category === 'position' ? '' : 'hidden' %>>
      <div class="wf-section-title">D&eacute;tails</div>
      <div class="wiki-meta-group">
        <p class="wiki-meta-label">Cat&eacute;gorie</p>
        <div class="wiki-meta-options">
          <label class="chip-option"><input type="radio" name="meta_categorie" value="penetration"           <%= ra(pm.categorie,'penetration') %>><span>P&eacute;n&eacute;tration</span></label>
          <label class="chip-option"><input type="radio" name="meta_categorie" value="fellation_cunnilingus" <%= ra(pm.categorie,'fellation_cunnilingus') %>><span>Fellation&nbsp;/ Cunnilingus</span></label>
          <label class="chip-option"><input type="radio" name="meta_categorie" value="anilingus"             <%= ra(pm.categorie,'anilingus') %>><span>Anilingus</span></label>
          <label class="chip-option"><input type="radio" name="meta_categorie" value="stimulation_manuelle" <%= ra(pm.categorie,'stimulation_manuelle') %>><span>Stimulation manuelle</span></label>
          <label class="chip-option"><input type="radio" name="meta_categorie" value="double_penetration"   <%= ra(pm.categorie,'double_penetration') %>><span>Double p&eacute;n&eacute;tration</span></label>
          <label class="chip-option"><input type="radio" name="meta_categorie" value="position_69"          <%= ra(pm.categorie,'position_69') %>><span>Position 69</span></label>
          <label class="chip-option"><input type="radio" name="meta_categorie" value="autre"                <%= ra(pm.categorie,'autre') %>><span>Autre</span></label>
        </div>
      </div>
      <div class="wiki-meta-group">
        <p class="wiki-meta-label">Au-dessus</p>
        <div class="wiki-meta-options">
          <label class="chip-option"><input type="radio" name="meta_qui_dessus" value="femme"    <%= ra(pm.qui_dessus,'femme') %>><span>Femme</span></label>
          <label class="chip-option"><input type="radio" name="meta_qui_dessus" value="homme"    <%= ra(pm.qui_dessus,'homme') %>><span>Homme</span></label>
          <label class="chip-option"><input type="radio" name="meta_qui_dessus" value="variable" <%= ra(pm.qui_dessus,'variable') %>><span>Variable</span></label>
          <label class="chip-option"><input type="radio" name="meta_qui_dessus" value="aucun"    <%= ra(pm.qui_dessus,'aucun') %>><span>Debout&nbsp;/ aucun</span></label>
        </div>
      </div>
      <div class="wiki-meta-group">
        <p class="wiki-meta-label">Canal(aux)</p>
        <div class="wiki-meta-options">
          <label class="chip-option"><input type="checkbox" name="meta_canal" value="vagin"  <%= ck(pmCanal,'vagin') %>><span>Vagin</span></label>
          <label class="chip-option"><input type="checkbox" name="meta_canal" value="anus"   <%= ck(pmCanal,'anus') %>><span>Anus</span></label>
          <label class="chip-option"><input type="checkbox" name="meta_canal" value="bouche" <%= ck(pmCanal,'bouche') %>><span>Bouche</span></label>
          <label class="chip-option"><input type="checkbox" name="meta_canal" value="mains"  <%= ck(pmCanal,'mains') %>><span>Mains</span></label>
          <label class="chip-option"><input type="checkbox" name="meta_canal" value="autre"  <%= ck(pmCanal,'autre') %>><span>Autre</span></label>
        </div>
      </div>
      <div class="wiki-meta-group">
        <p class="wiki-meta-label">Orientation</p>
        <div class="wiki-meta-options">
          <label class="chip-option"><input type="checkbox" name="meta_orientation" value="face_a_face"     <%= ck(pmOri,'face_a_face') %>><span>Face &agrave; face</span></label>
          <label class="chip-option"><input type="checkbox" name="meta_orientation" value="face_contre_dos" <%= ck(pmOri,'face_contre_dos') %>><span>Face contre dos</span></label>
          <label class="chip-option"><input type="checkbox" name="meta_orientation" value="cote_a_cote"     <%= ck(pmOri,'cote_a_cote') %>><span>C&ocirc;te &agrave; c&ocirc;te</span></label>
          <label class="chip-option"><input type="checkbox" name="meta_orientation" value="acrobatique"     <%= ck(pmOri,'acrobatique') %>><span>Acrobatique</span></label>
          <label class="chip-option"><input type="checkbox" name="meta_orientation" value="autre"           <%= ck(pmOri,'autre') %>><span>Autre</span></label>
        </div>
      </div>
      <div class="wiki-meta-group">
        <p class="wiki-meta-label">Nombre de partenaires</p>
        <div class="wiki-meta-options">
          <label class="chip-option"><input type="radio" name="meta_nb_partenaires" value="2"        <%= ra(pm.nb_partenaires,'2') %>><span>2</span></label>
          <label class="chip-option"><input type="radio" name="meta_nb_partenaires" value="3"        <%= ra(pm.nb_partenaires,'3') %>><span>3</span></label>
          <label class="chip-option"><input type="radio" name="meta_nb_partenaires" value="4plus"    <%= ra(pm.nb_partenaires,'4plus') %>><span>4+</span></label>
          <label class="chip-option"><input type="radio" name="meta_nb_partenaires" value="variable" <%= ra(pm.nb_partenaires,'variable') %>><span>Variable</span></label>
        </div>
      </div>
      <div class="wiki-meta-group">
        <p class="wiki-meta-label">Partenaire actif</p>
        <div class="wiki-meta-options">
          <label class="chip-option"><input type="radio" name="meta_partenaire_actif" value="femme"    <%= ra(pm.partenaire_actif,'femme') %>><span>Femme</span></label>
          <label class="chip-option"><input type="radio" name="meta_partenaire_actif" value="homme"    <%= ra(pm.partenaire_actif,'homme') %>><span>Homme</span></label>
          <label class="chip-option"><input type="radio" name="meta_partenaire_actif" value="les_deux" <%= ra(pm.partenaire_actif,'les_deux') %>><span>Les deux</span></label>
          <label class="chip-option"><input type="radio" name="meta_partenaire_actif" value="variable" <%= ra(pm.partenaire_actif,'variable') %>><span>Variable</span></label>
        </div>
      </div>
      <div class="wiki-meta-group">
        <p class="wiki-meta-label">Supports possibles</p>
        <div class="wiki-meta-options">
          <label class="chip-option"><input type="checkbox" name="meta_supports" value="lit"    <%= ck(pmSup,'lit') %>><span>Lit</span></label>
          <label class="chip-option"><input type="checkbox" name="meta_supports" value="sol"    <%= ck(pmSup,'sol') %>><span>Sol</span></label>
          <label class="chip-option"><input type="checkbox" name="meta_supports" value="chaise" <%= ck(pmSup,'chaise') %>><span>Chaise</span></label>
          <label class="chip-option"><input type="checkbox" name="meta_supports" value="canape" <%= ck(pmSup,'canape') %>><span>Canap&eacute;&nbsp;/ Bord de lit</span></label>
          <label class="chip-option"><input type="checkbox" name="meta_supports" value="mur"    <%= ck(pmSup,'mur') %>><span>Contre un mur</span></label>
          <label class="chip-option"><input type="checkbox" name="meta_supports" value="table"  <%= ck(pmSup,'table') %>><span>Table&nbsp;/ Plan</span></label>
          <label class="chip-option"><input type="checkbox" name="meta_supports" value="bain"   <%= ck(pmSup,'bain') %>><span>Bain&nbsp;/ Douche</span></label>
          <label class="chip-option"><input type="checkbox" name="meta_supports" value="autre"  <%= ck(pmSup,'autre') %>><span>Autre</span></label>
        </div>
      </div>
      <div class="wiki-meta-group">
        <p class="wiki-meta-label">Variantes</p>
        <div class="wiki-var-editor" id="wiki-variante-editor">
          <div class="wiki-var-list"></div>
          <button type="button" class="wiki-var-add-btn">+ Ajouter une variante</button>
        </div>
        <input type="hidden" name="meta_variantes" id="wiki-variantes-hidden" value="<%= JSON.stringify(pm.variantes || []) %>" />
      </div>
      <div class="wiki-meta-group">
        <p class="wiki-meta-label">Informations utiles</p>
        <textarea name="meta_infos_utiles" class="wiki-textarea wiki-pos-textarea" rows="5" placeholder="Conditions, pr&eacute;requis&hellip;"><%= pm.infos_utiles || '' %></textarea>
      </div>
      <div class="wiki-meta-group">
        <p class="wiki-meta-label">Nouvelles</p>
        <textarea name="meta_nouvelles" class="wiki-textarea wiki-pos-textarea" rows="5" placeholder="Une courte histoire&hellip;"><%= pm.nouvelles || '' %></textarea>
      </div>
    </div>

    <%# ── Actions mobile uniquement ── %>
    <div class="wiki-form-actions wf-mobile-actions">
      <button type="submit">Enregistrer</button>
      <a href="<%= returnTo || (page.id ? '/wiki/' + page.id : '/wiki') %>" class="link-button">Annuler</a>
    </div>
  </form>

  <% if (page.id) { %>
  <%# ── Pages liées : champ uniquement ── %>
  <div class="wiki-page-links" data-page-id="<%= page.id %>">
    <div class="wiki-pl-body">
      <div class="wiki-pl-section">
        <div class="wiki-pl-cards" data-role="links"></div>
      </div>
      <div class="wiki-pl-section wiki-pl-backlinks-section" hidden>
        <p class="wiki-pl-back-label">R&eacute;f&eacute;renc&eacute;e par</p>
        <div class="wiki-pl-cards" data-role="backlinks"></div>
      </div>
    </div>
    <div class="wiki-pl-add">
      <input type="text" class="wiki-pl-search" placeholder="Lier une autre page&hellip;" autocomplete="off" />
      <ul class="wiki-pl-results"></ul>
    </div>
  </div>

  <%# ── Questions liées : champ uniquement ── %>
  <div class="wiki-question-links" data-page-id="<%= page.id %>">
    <ul class="wiki-ql-list"></ul>
    <div class="wiki-ql-add">
      <input type="text" class="wiki-ql-search" placeholder="Associer une question&hellip;" autocomplete="off" />
      <ul class="wiki-ql-results"></ul>
    </div>
  </div>
  <% } %>
</main>
<script>window._wikiEditContent = <%- JSON.stringify(page.content || '') %>;</script>
<script src="/wiki.js?v=<%= assetVersion %>"></script>
<%- include('partials/foot') %>
