<%- include('partials/head', { title: 'Modifier \u2014 ' + page.title + ' \u2014 ' + config.title }) %>
<main class="container">
  <%- include('partials/top-nav', { config: config }) %>
  <a href="/wiki/<%= page.id %>" class="link-button">&larr; Retour</a>

  <% var cat = categories.find(function(c) { return c.key === page.category; }); %>

  <form method="POST" action="/wiki/<%= page.id %>" enctype="multipart/form-data" class="wiki-form" id="wiki-edit-form">

    <%# ─ Catégorie : sélecteur discret ─ %>
    <div class="wiki-form-top-row">
      <select name="category" id="wiki-category-select" class="wiki-cat-inline-select">
        <% categories.forEach(function(c) { %>
          <option value="<%= c.key %>" data-hue="<%= c.hue %>" <%= c.key === page.category ? 'selected' : '' %>><%= c.label %></option>
        <% }) %>
      </select>
    </div>

    <%# ─ Titre ─ %>
    <input type="text" name="title" class="wiki-title-input" required value="<%= page.title %>" placeholder="Titre&hellip;" />

    <%# ─ On possède ─ %>
    <label class="chip-option wiki-owned-chip" id="wiki-owned-field" <%= (page.category === 'objets' || page.category === 'tenues') ? '' : 'hidden' %>>
      <input type="checkbox" name="owned" <%= page.owned ? 'checked' : '' %> />
      <span>On poss&egrave;de</span>
    </label>

    <%# ─ Éditeur ─ %>
    <div class="wiki-editor">
      <div class="md-toolbar">
        <button type="button" class="md-btn" data-md="bold" title="Gras (Ctrl+B)"><strong>B</strong></button>
        <button type="button" class="md-btn md-btn-italic" data-md="italic" title="Italique (Ctrl+I)"><em>I</em></button>
        <span class="md-sep"></span>
        <button type="button" class="md-btn" data-md="h2">H2</button>
        <button type="button" class="md-btn" data-md="h3">H3</button>
        <span class="md-sep"></span>
        <button type="button" class="md-btn" data-md="list">&#8226;&nbsp;Liste</button>
        <button type="button" class="md-btn" data-md="hr">&mdash;</button>
        <div class="md-toolbar-spacer"></div>
        <button type="button" class="md-btn md-preview-btn">Aper&ccedil;u</button>
      </div>
      <textarea name="content" class="wiki-textarea" rows="10" placeholder="Description, notes\u2026 (Markdown support\u00e9)"><%= page.content %></textarea>
      <div class="wiki-md-preview wiki-md" hidden></div>
    </div>

    <%
      var pm = page.meta || {};
    %>

    <%# ─ Champs fantasmes ─ %>
    <div class="wiki-fantasmes-meta" <%= page.category === 'fantasmes' ? '' : 'hidden' %>>
      <div class="wiki-meta-group">
        <p class="wiki-meta-label">Sous-cat&eacute;gorie</p>
        <div class="wiki-meta-options">
          <% fantasmesSubs.forEach(function(s) { %>
            <label class="chip-option"><input type="radio" name="meta_sous_cat" value="<%= s.key %>" <%= pm.sous_cat === s.key ? 'checked' : '' %>><span><%= s.label %></span></label>
          <% }) %>
        </div>
      </div>
    </div>

    <%# ─ Champs partenaires ─ %>
    <div class="wiki-partenaires-meta" <%= page.category === 'partenaires' ? '' : 'hidden' %>>
      <div class="wiki-meta-group">
        <p class="wiki-meta-label">Nombre de femmes</p>
        <div class="wiki-meta-options">
          <% ['0','1','2','3','nombreux'].forEach(function(v) { %>
            <label class="chip-option"><input type="radio" name="meta_nb_femmes" value="<%= v %>" <%= pm.nb_femmes === v ? 'checked' : '' %>><span><%= v === 'nombreux' ? 'Nombreuses' : v %></span></label>
          <% }) %>
        </div>
      </div>
      <div class="wiki-meta-group">
        <p class="wiki-meta-label">Nombre d&apos;hommes</p>
        <div class="wiki-meta-options">
          <% ['0','1','2','3','nombreux'].forEach(function(v) { %>
            <label class="chip-option"><input type="radio" name="meta_nb_hommes" value="<%= v %>" <%= pm.nb_hommes === v ? 'checked' : '' %>><span><%= v === 'nombreux' ? 'Nombreux' : v %></span></label>
          <% }) %>
        </div>
      </div>
    </div>

    <%# ─ Champs objets ─ %>
    <div class="wiki-objets-meta" <%= page.category === 'objets' ? '' : 'hidden' %>>
      <div class="wiki-meta-group">
        <p class="wiki-meta-label">Type de gode</p>
        <div class="wiki-meta-options">
          <% [['animal','Animal'],['monstre','Monstre'],['fantaisiste','Fantaisiste'],['ethnique','Ethnique'],['autre','Autre']].forEach(function(o) { %>
            <label class="chip-option"><input type="radio" name="meta_type_gode" value="<%= o[0] %>" <%= pm.type_gode === o[0] ? 'checked' : '' %>><span><%= o[1] %></span></label>
          <% }) %>
        </div>
      </div>
    </div>

    <%# ─ Champs lieux ─ %>
    <div class="wiki-lieux-meta" <%= page.category === 'lieux' ? '' : 'hidden' %>>
      <div class="wiki-meta-group">
        <p class="wiki-meta-label">Type de lieu</p>
        <div class="wiki-meta-options">
          <label class="chip-option"><input type="radio" name="meta_type_lieu" value="prive"  <%= pm.type_lieu === 'prive'  ? 'checked' : '' %>><span>Priv&eacute;</span></label>
          <label class="chip-option"><input type="radio" name="meta_type_lieu" value="public" <%= pm.type_lieu === 'public' ? 'checked' : '' %>><span>Public</span></label>
          <label class="chip-option"><input type="radio" name="meta_type_lieu" value="cache"  <%= pm.type_lieu === 'cache'  ? 'checked' : '' %>><span>Cach&eacute;</span></label>
        </div>
      </div>
    </div>

    <%# ─ Champs position ─ %>
    <%
      var pmCanal = pm.canal || [];
    %>
    <div class="wiki-position-meta" <%= page.category === 'position' ? '' : 'hidden' %>>
      <div class="wiki-meta-group">
        <p class="wiki-meta-label">Qui est au-dessus&nbsp;?</p>
        <div class="wiki-meta-options">
          <label class="chip-option"><input type="radio" name="meta_qui_dessus" value="femme"    <%= pm.qui_dessus === 'femme'    ? 'checked' : '' %>><span>Femme</span></label>
          <label class="chip-option"><input type="radio" name="meta_qui_dessus" value="homme"    <%= pm.qui_dessus === 'homme'    ? 'checked' : '' %>><span>Homme</span></label>
          <label class="chip-option"><input type="radio" name="meta_qui_dessus" value="variable" <%= pm.qui_dessus === 'variable' ? 'checked' : '' %>><span>Variable</span></label>
          <label class="chip-option"><input type="radio" name="meta_qui_dessus" value="aucun"    <%= pm.qui_dessus === 'aucun'    ? 'checked' : '' %>><span>Aucun&nbsp;/ debout</span></label>
        </div>
      </div>
      <div class="wiki-meta-group">
        <p class="wiki-meta-label">Canal(aux)</p>
        <div class="wiki-meta-options">
          <label class="chip-option"><input type="checkbox" name="meta_canal" value="vagin"  <%= pmCanal.indexOf('vagin')  !== -1 ? 'checked' : '' %>><span>Vagin</span></label>
          <label class="chip-option"><input type="checkbox" name="meta_canal" value="anus"   <%= pmCanal.indexOf('anus')   !== -1 ? 'checked' : '' %>><span>Anus</span></label>
          <label class="chip-option"><input type="checkbox" name="meta_canal" value="bouche" <%= pmCanal.indexOf('bouche') !== -1 ? 'checked' : '' %>><span>Bouche</span></label>
          <label class="chip-option"><input type="checkbox" name="meta_canal" value="mains"  <%= pmCanal.indexOf('mains')  !== -1 ? 'checked' : '' %>><span>Mains</span></label>
          <label class="chip-option"><input type="checkbox" name="meta_canal" value="autre"  <%= pmCanal.indexOf('autre')  !== -1 ? 'checked' : '' %>><span>Autre</span></label>
        </div>
      </div>
      <div class="wiki-meta-group">
        <p class="wiki-meta-label">Orientation</p>
        <div class="wiki-meta-options">
          <%
            var pmOri = Array.isArray(pm.orientation) ? pm.orientation : (pm.orientation ? [pm.orientation] : []);
          %>
          <label class="chip-option"><input type="checkbox" name="meta_orientation" value="face_a_face"     <%= pmOri.indexOf('face_a_face')     !== -1 ? 'checked' : '' %>><span>Face &agrave; face</span></label>
          <label class="chip-option"><input type="checkbox" name="meta_orientation" value="face_contre_dos" <%= pmOri.indexOf('face_contre_dos') !== -1 ? 'checked' : '' %>><span>Face contre dos</span></label>
          <label class="chip-option"><input type="checkbox" name="meta_orientation" value="acrobatique"     <%= pmOri.indexOf('acrobatique')     !== -1 ? 'checked' : '' %>><span>Acrobatique</span></label>
          <label class="chip-option"><input type="checkbox" name="meta_orientation" value="autre"           <%= pmOri.indexOf('autre')           !== -1 ? 'checked' : '' %>><span>Autre</span></label>
        </div>
      </div>
    </div>

    <%# ─ Tags ─ %>
    <div class="wiki-tags-widget">
      <div class="wiki-tags-board">
        <input type="text" class="wiki-tags-typing" placeholder="Ajouter un tag&hellip;" autocomplete="off" />
      </div>
      <input type="hidden" name="tags" class="wiki-tags-hidden" value="<%= page.tags.join(', ') %>" />
      <% if (allTags.length) { %>
        <div class="wiki-tag-suggestions">
          <% allTags.forEach(function(t) { %>
            <button type="button" class="wiki-tag-suggest-chip" data-tag="<%= t %>"><%= t %></button>
          <% }) %>
        </div>
      <% } %>
    </div>

    <%# ─ Images ─ %>
    <div class="wiki-image-field">
      <% if (page.imagePaths && page.imagePaths.length) { %>
        <div class="wiki-images-existing">
          <% page.imagePaths.forEach(function(src) { %>
            <div class="wiki-existing-img-wrap">
              <img src="<%= src %>" alt="" class="wiki-form-existing-image" />
              <label class="wiki-img-remove-label">
                <input type="checkbox" name="remove_image" value="<%= src %>" />
                <span>&#215;</span>
              </label>
            </div>
          <% }) %>
        </div>
      <% } %>
      <label class="wiki-image-add-label">
        <span>+ Ajouter des images</span>
        <input type="file" name="images" accept="image/*" multiple class="wiki-image-input" />
      </label>
      <div class="wiki-new-previews"></div>
    </div>

    <button type="submit">Enregistrer</button>
  </form>
</main>
<script src="/wiki.js?v=<%= assetVersion %>"></script>
<%- include('partials/foot') %>
