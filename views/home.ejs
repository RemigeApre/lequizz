<%- include('partials/head', { title: config.title }) %>
<main class="container wide">
  <%- include('partials/top-nav', { config: config }) %>

  <p class="home-message"><%= config.intro %></p>

  <div class="home-shortcuts">
    <a href="/wiki" class="home-shortcut">Wiki</a>
    <% if (currentUser) { %><a href="/liens" class="home-shortcut">Liens</a><% } %>
  </div>

  <% if (!currentUser) { %>
    <p class="intro">Connecte-toi (ic&ocirc;ne &#128273; en haut) pour acc&eacute;der &agrave; la galerie, la BD, le quizz et les images du wiki.</p>
  <% } %>

  <% if (currentUser && featuredPages && featuredPages.length) { %>
  <section class="home-featured">
    <h2 class="home-featured-heading">Ce qui pourrait t&apos;int&eacute;resser</h2>
    <div class="home-featured-strip">
      <% featuredPages.forEach(function (p) { %>
        <a href="/wiki/<%= p.id %>" class="home-featured-card">
          <% if (p.imagePaths && p.imagePaths.length) { %>
            <div class="home-featured-img-wrap">
              <img src="<%= p.imagePaths[0] %>" alt="" class="home-featured-img" />
            </div>
          <% } else { %>
            <div class="home-featured-img-wrap home-featured-img-placeholder"></div>
          <% } %>
          <span class="home-featured-title"><%= p.title %></span>
        </a>
      <% }) %>
    </div>
  </section>
  <% } %>

  <% if (currentUser) { %>
  <div class="section-cards">
    <% config.sections.forEach(function (s, i) { %>
      <a class="section-card" href="/section/<%= i %>" style="--card-color: <%= s.color || 'var(--accent)' %>">
        <span class="section-card-number"><%= i + 1 %></span>
        <span class="section-card-title"><%= s.title %></span>
      </a>
    <% }) %>
  </div>
  <% } %>
</main>

<% if (currentUser) { %>
<div id="quiz-warning-popup" class="quiz-warning-overlay" hidden>
  <div class="quiz-warning-box">
    <p class="quiz-warning-text">Le quizz n&apos;a pas &eacute;t&eacute; retravill&eacute;. Actuellement seul wiki et galerie l&apos;ont &eacute;t&eacute;. Vous &ecirc;tes alors sur un espace du site ancien et non &agrave; jour.</p>
    <button type="button" id="quiz-warning-ok" class="quiz-warning-btn">OK</button>
  </div>
</div>
<script>
(function() {
  if (!sessionStorage.getItem("quiz-warning-seen")) {
    var popup = document.getElementById("quiz-warning-popup");
    if (popup) popup.hidden = false;
    var btn = document.getElementById("quiz-warning-ok");
    if (btn) btn.addEventListener("click", function() {
      popup.hidden = true;
      sessionStorage.setItem("quiz-warning-seen", "1");
    });
  }
})();
</script>
<% } %>

<%- include('partials/foot') %>
